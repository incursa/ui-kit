<section class=\"inc-card\">\n <div class=\"inc-card__header\">\n <h2 class=\"inc-card__title\">Native Controls</h2>\n </div>\n <div class=\"inc-card__body demo-reference-grid\">\n <div class=\"demo-preview demo-stack\">\n <details class=\"inc-disclosure\" open>\n <summary class=\"inc-disclosure__summary\">\n <span class=\"demo-disclosure-title\">\n <span class=\"inc-disclosure__title\">Billing summary</span>\n <span class=\"inc-badge inc-badge--info inc-badge--pill\">3 items</span>\n </span>\n <span class=\"inc-disclosure__meta\">Native details</span>\n </summary>\n <div class=\"inc-disclosure__content\">\n <p class=\"inc-text inc-text--regular\">Example disclosure body.</p>\n </div>\n </details>\n <details class=\"inc-native-menu inc-native-menu--block\">\n <summary class=\"inc-native-menu__summary\">\n <span class=\"inc-user-menu__avatar\">AP</span>\n <span class=\"inc-native-menu__section-title\">\n <span class=\"inc-user-menu__name\">Queue Actions</span>\n <span class=\"inc-user-menu__detail\">Summary-based menu</span>\n </span>\n </summary>\n <div class=\"inc-native-menu__panel\">\n <div class=\"inc-native-menu__header\">Quick actions</div>\n <a class=\"inc-native-menu__item\" href=\"#\">Export current view</a>\n <a class=\"inc-native-menu__item\" href=\"#\">Save filter preset</a>\n </div>\n </details>\n <div class=\"demo-layout-grid demo-layout-grid--2\">\n <div class=\"inc-u-stack-xs\">\n <label class=\"inc-form__label\" for=\"ref-progress\">Import completion</label>\n <progress id=\"ref-progress\" class=\"inc-progress inc-progress--success\" max=\"100\" value=\"72\">72%</progress>\n </div>\n <div class=\"inc-u-stack-xs\">\n <label class=\"inc-form__label\" for=\"ref-meter\">Data quality</label>\n <meter id=\"ref-meter\" class=\"inc-meter inc-meter--warning\" min=\"0\" max=\"100\" low=\"65\" high=\"90\" optimum=\"100\" value=\"74\">74%</meter>\n </div>\n </div>\n <div class=\"demo-chip-row\">\n <button class=\"inc-btn inc-btn--primary\" type=\"button\" data-