      "searchText": "forms-and-validation.html\nRaw curated file content for forms-and-validation.html.\n<!DOCTYPE html>\n<html lang=\"en\" data-bs-theme=\"light\">\n<head>\n <meta charset=\"utf-8\">\n <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n <title>Incursa Design Language Showcase - Forms And Validation</title>\n <script>\n (() => {\n const storageKey = \"inc-theme-mode\";\n const resolveTheme = (mode) => mode === \"dark\" || mode === \"light\"\n ? mode\n : (window.matchMedia && window.matchMedia(\"(prefers-color-scheme: dark)\").matches ? \"dark\" : \"light\");\n let mode = \"system\";\n\n try {\n const storedMode = window.localStorage.getItem(storageKey);\n\n if (storedMode === \"light\" || storedMode === \"dark\" || storedMode === \"system\") {\n mode = storedMode;\n }\n } catch {\n // Ignore storage restrictions before the helper bootstraps.\n }\n\n document.documentElement.setAttribute(\"data-inc-theme-mode\", mode);\n document.documentElement.setAttribute(\"data-bs-theme\", resolveTheme(mode));\n document.documentElement.style.colorScheme = resolveTheme(mode);\n })();\n </script>\n <link rel=\"stylesheet\" href=\"./dist/inc-design-language.css\">\n <link rel=\"stylesheet\" href=\"./showcase.css\">\n</head>\n<body>\n <div class=\"inc-app-shell\">\n <header class=\"inc-app-shell__header\">\n <nav class=\"inc-navbar inc-navbar--app inc-navbar--expand-lg\">\n <div class=\"container-fluid\">\n <a class=\"inc-navbar__brand\" href=\"./index.html\">Incursa</a>\n <div class=\"inc-navbar__collapse\">\n <div class=\"inc-navbar__nav\">\n <a class=\"nav-link\" href=\"./index.html\">Examples</a>\n <a class=\"nav-link\" href=\"./demo.html\">Dashboard</a>\n <a class=\"nav-link\" href=\"./work-queue.html\">Work Queue</a>\n <a class=\"nav-link\" href=\"./record-detail.html\">Record Detail</a>\n <a class=\"nav-link\" href=\"./native-patterns.html\">Native Patterns</a>\n <a class=\"nav-link\" href=\"./overlay-workflows.html\">Overlays</a>\n <a class=\"nav-link\" href=\"./states.html\">States</a>\n <a class=\"nav-link active\" href=\"./forms-and-validation.html\">Forms</a>\n <a class=\"nav-link\" href=\"./data-grid-advanced.html\">Data Grid</a>\n <a class=\"nav-link\" href=\"./web-components.html\">Web Components</a>\n <a class=\"nav-link\" href=\"./reference.html\">Reference</a>\n </div>\n <div class=\"inc-navbar__utilities\">\n <div data-inc-theme-switcher data-inc-theme-switcher-variant=\"navbar\"></div>\n <details class=\"inc-native-menu inc-native-menu--navbar\">\n <summary class=\"inc-native-menu__summary\">\n <span class=\"inc-user-menu__avatar\">SM</span>\n <span class=\"inc-user-menu__meta\">\n <span class=\"inc-user-menu__name\">Sam McAravey</span>\n <span class=\"inc-user-menu__detail\">Administrator</span>\n </span>\n </summary>\n <div class=\"inc-native-menu__panel\">\n <div class=\"inc-native-menu__header\">Signed in as Sam McAravey</div>\n <a class=\"inc-native-menu__item\" href=\"#\">Profile</a>\n <a class=\"inc-native-menu__item\" href=\"#\">Preferences</a>\n <a class=\"inc-native-menu__item\" href=\"#\">Sign out</a>\n </div>\n </details>\n </div>\n </div>\n </div>\n </nav>\n <div class=\"inc-nav-triad\">\n <div class=\"inc-nav-triad__container\">\n <div class=\"inc-nav-triad__back\"></div>\n <div class=\"inc-nav-triad__breadcrumb\">\n <ol class=\"inc-breadcrumb\">\n <li class=\"inc-breadcrumb__item\"><a href=\"./index.html\">Examples</a></li>\n <li class=\"inc-breadcrumb__item active\"><span>Forms And Validation</span></li>\n </ol>\n </div>\n <div class=\"inc-nav-triad__origin\"></div>\n </div>\n </div>\n </header>\n <div class=\"inc-app-shell__body\">\n <div class=\"inc-app-shell__main\">\n <main class=\"inc-app-shell__content\">\n <div class=\"inc-section-container demo-stack\">\n <section class=\"inc-page-header\">\n <div class=\"inc-page-header__title\">\n <p class=\"demo-eyebrow\">Forms And Filters</p>\n <h1 class=\"inc-heading inc-heading--h1\">Validation, dense toolbars, and edit-friendly detail blocks</h1>\n <p class=\"inc-text inc-text--regular inc-text--muted\">This page covers required labels, help text, validation messaging, error summaries, saved-filter chips, and mixed read-only/edit surfaces.</p>\n </div>\n </section>\n\n <section class=\"inc-card\">\n <div class=\"inc-card__header\">\n <h2 class=\"inc-card__title\">Validation Summary</h2>\n </div>\n <div class=\"inc-card__body inc-stack inc-stack--gap-md\">\n <div class=\"inc-form__error-summary\">\n <h3 class=\"inc-form__error-summary-title\">There are 3 issues to fix before approval</h3>\n <ul class=\"inc-form__error-summary-list\">\n <li>Contract number is required.</li>\n <li>Billing period must be selected.</li>\n <li>Export contact email is not valid.</li>\n </ul>\n </div>\n\n <div class=\"demo-layout-grid demo-layout-grid--2\">\n <div class=\"inc-form__group\">\n <label class=\"inc-form__label inc-form__label--required\" for=\"form-project\">Project name</label>\n <input id=\"form-project\" class=\"inc-form__control is-valid\" type=\"text\" value=\"North Campus Expansion\">\n <p class=\"inc-form__hint\">Use the legal project name from the ERP contract.</p>\n <p class=\"inc-form__feedback inc-form__feedback--success\">Looks good.</p>\n </div>\n\n <div class=\"inc-form__group\">\n <label class=\"inc-form__label inc-form__label--required\" for=\"form-contract\">Contract number</label>\n <input id=\"form-contract\" class=\"inc-form__control is-invalid\" type=\"text\" value=\"\" aria-invalid=\"true\">\n <p class=\"inc-form__hint\">Visible to AP and legal reviewers.</p>\n <p class=\"inc-form__feedback inc-form__feedback--error\">Contract number is required.</p>\n </div>\n\n <div class=\"inc-form__group\">\n <label class=\"inc-form__label inc-form__label--required\" for=\"form-period\">Billing period</label>\n <select id=\"form-period\" class=\"inc-form__select is-invalid\" aria-invalid=\"true\">\n <option selected>Select a period</option>\n <option>March 2026</option>\n <option>April 2026</option>\n </select>\n <p class=\"inc-form__feedback inc-form__feedback--error\">Choose the period that will appear on export.</p>\n </div>\n\n <div class=\"inc-form__group\">\n <label class=\"inc-form__label\" for=\"form-email\">Export contact</label>\n <input id=\"form-email\" class=\"inc-form__control\" type=\"email\" value=\"ops@incursa.com\">\n <p class=\"inc-form__hint\">Optional. Used only for exception emails.</p>\n </div>\n </div>\n\n <fieldset class=\"inc-form__fieldset\">\n <legend class=\"inc-form__legend\">Approval options</legend>\n <div class=\"inc-form__choices inc-form__choices--inline\">\n <div class=\"inc-form__check\">\n <input class=\"inc-form__check-input\" type=\"checkbox\" id=\"form-related\" checked>\n <label class=\"inc-form__check-label\" for=\"form-related\">Include related contract documents</label>\n </div>\n <div class=\"inc-form__check inc-form__switch\">\n <input class=\"inc-form__check-input\" type=\"checkbox\" id=\"form-notifications\" checked>\n <label class=\"inc-form__check-label\" for=\"form-notifications\">Send notifications after approval</label>\n </div>\n </div>\n </fieldset>\n <fieldset class=\"inc-form__fieldset\">\n <legend class=\"inc-form__legend\">Approval route</legend>\n <div class=\"inc-form__choices inc-form__choices--inline\">\n <div class=\"inc-form__check\">\n <input class=\"inc-form__check-input\" type=\"radio\" id=\"form-route-fast\" name=\"form-route\" checked>\n <label class=\"inc-form__check-label\" for=\"form-route-fast\">Fast approval</label>\n </div>\n <div class=\"inc-form__check\">\n <input class=\"inc-form__check-input\" type=\"radio\" id=\"form-route-standard\" name=\"form-route\">\n <label class=\"inc-form__check-label\" for=\"form-route-standard\">Standard approval</label>\n </div>\n </div>\n </fieldset>\n </div>\n </section>\n\n <section class=\"inc-card\">\n <div class=\"inc-card__header\">\n <h2 class=\"inc-card__title\">Dense Filter Toolbar</h2>\n </div>\n <div class=\"inc-card__body inc-stack inc-stack--gap-md\">\n <section class=\"inc-filter-bar\">\n <div class=\"inc-filter-bar__main\">\n <div class=\"inc-filter-bar__field inc-filter-bar__field--grow\">\n <label class=\"inc-form__label\" for=\"filter-search\">Search</label>\n <input id=\"filter-search\" class=\"inc-form__control inc-form__control--sm\" type=\"text\" value=\"North Campus\">\n </div>\n <div class=\"inc-filter-bar__field\">\n <label class=\"inc-form__label\" for=\"filter-status\">Status</label>\n <select id=\"filter-status\" class=\"inc-form__select inc-form__select--sm\">\n <option>All statuses</option>\n <option selected>Needs review</option>\n <option>Ready</option>\n </select>\n </div>\n <div class=\"inc-filter-bar__field\">\n <label class=\"inc-form__label\" for=\"filter-owner\">Owner</label>\n <select id=\"filter-owner\" class=\"inc-form__select inc-form__select--sm\">\n <option selected>AP Team</option>\n <option>Legal Review</option>\n </select>\n </div>\n <div class=\"inc-filter-bar__field\">\n <label class=\"inc-form__label\" for=\"filter-amount\">Minimum amount</label>\n <div class=\"inc-input-group inc-input-group--sm\">\n <span class=\"inc-input-group__text\">$</span>\n <input id=\"filter-amount\" class=\"inc-form__control\" type=\"text\" value=\"10000\">\n </div>\n </div>\n </div>\n <div class=\"inc-filter-bar__actions\">\n <div class=\"inc-filter-bar__chips\">\n <span class=\"inc-filter-chip inc-filter-chip--accent\">Status: Needs review <button class=\"inc-filter-chip__remove\" type=\"button\" aria-label=\"Remove filter\">×</button></span>\n <span class=\"inc-filter-chip\">Owner: AP Team <button class=\"inc-filter-chip__remove\" type=\"button\" aria-label=\"Remove filter\">×</button></span>\n <span class=\"inc-filter-chip\">Amount: $10,000+ <button class=\"inc-filter-chip__remove\" type=\"button\" aria-label=\"Remove filter\">×</button></span>\n </div>\n <div class=\"demo-chip-row\">\n <a class=\"inc-btn inc-btn--outline-secondary inc-btn--sm\" href=\"#\">Clear All</a>\n <a class=\"inc-btn inc-btn--secondary inc-btn--sm\" href=\"#\">Save View</a>\n <a class=\"inc-btn inc-btn--primary inc-btn--sm\" href=\"#\">Apply Filters</a>\n </div>\n </div>\n </section>\n <p class=\"demo-inline-note\">This is the pattern to reuse for search-heavy B2B screens: fields above, active chips and actions below.</p>\n </div>\n </section>\n\n <section class=\"demo-layout-grid demo-layout-grid--2\">\n <article class=\"inc-card\">\n <div class=\"inc-card__header\">\n <h2 class=\"inc-card__title\">Read-Only Detail Grid</h2>\n </div>\n <div class=\"inc-card__body\">\n <div class=\"inc-key-value-grid\">\n <dl class=\"inc-key-value inc-key-value--card\">\n <dt class=\"inc-key-value__label\">Project</dt>\n <dd class=\"inc-key-value__value inc-key-value__value--strong\">North Campus Expansion</dd>\n </dl>\n <dl class=\"inc-key-value inc-key-value--card\">\n <dt class=\"inc-key-value__label\">Record Id</dt>\n <dd class=\"inc-key-value__value inc-key-value__value--data\">AP-2026-00142</dd>\n </dl>\n <dl class=\"inc-key-value inc-key-value--card\">\n <dt class=\"inc-key-value__label\">Current Request</dt>\n <dd class=\"inc-key-value__value inc-key-value__value--data\">$18,240.22</dd>\n </dl>\n <dl class=\"inc-key-value inc-key-value--card\">\n <dt class=\"inc-key-value__label\">Status</dt>\n <dd class=\"inc-key-value__value\">Needs Review</dd>\n </dl>\n </div>\n </div>\n </article>\n\n <article class=\"inc-card\">\n <div class=\"inc-card__header\">\n <h2 class=\"inc-card__title\">Inline Edit Pattern</h2>\n </div>\n <div class=\"inc-card__body inc-stack inc-stack--gap-md\">\n <div class=\"demo-surface-muted\">\n <div class=\"inc-flex-between\">\n <div>\n <div class=\"inc-text inc-text--small inc-text--muted\">Default review owner</div>\n <div class=\"inc-text inc-text--regular-semibold\">AP Team</div>\n </div>\n <a class=\"inc-btn inc-btn--outline-secondary inc-btn--sm\" href=\"#\">Edit</a>\n </div>\n </div>\n <div class=\"demo-surface-muted\">\n <div class=\"inc-stack inc-stack--gap-sm\">\n <div class=\"inc-form__group\">\n <label class=\"inc-form__label\" for=\"inline-owner\">Default review owner</label>\n <select id=\"inline-owner\" class=\"inc-form__select inc-form__select--sm\">\n <option selected>AP Team</option>\n <option>Legal Review</option>\n <option>Regional Controllers</option>\n </select>\n </div>\n <div class=\"demo-chip-row\">\n <a class=\"inc-btn inc-btn--secondary inc-btn--sm\" href=\"#\">Cancel</a>\n <a class=\"inc-btn inc-btn--primary inc-btn--sm\" href=\"#\">Save Change</a>\n </div>\n </div>\n </div>\n </div>\n </article>\n </section>\n </div>\n </main>\n <footer class=\"inc-app-shell__footer inc-footer-bar\">\n <div class=\"inc-footer-bar__meta\">Validation states, filter bars, and read-only/edit detail patterns.</div>\n </footer>\n </div>\n </div>\n </div>\n <script src=\"./dist/inc-design-language.js\"></script>\n</body>\n</html>\n\nforms-and-validation.html\nforms-and-validation-html\nforms-and-validation.html"
    },
