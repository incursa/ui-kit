      "searchText": "overlay-workflows.html\nRaw curated file content for overlay-workflows.html.\n<!DOCTYPE html>\n<html lang=\"en\" data-bs-theme=\"light\">\n<head>\n <meta charset=\"utf-8\">\n <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n <title>Incursa Design Language Showcase - Overlay Workflows</title>\n <script>\n (() => {\n const storageKey = \"inc-theme-mode\";\n const resolveTheme = (mode) => mode === \"dark\" || mode === \"light\"\n ? mode\n : (window.matchMedia && window.matchMedia(\"(prefers-color-scheme: dark)\").matches ? \"dark\" : \"light\");\n let mode = \"system\";\n\n try {\n const storedMode = window.localStorage.getItem(storageKey);\n\n if (storedMode === \"light\" || storedMode === \"dark\" || storedMode === \"system\") {\n mode = storedMode;\n }\n } catch {\n // Ignore storage restrictions before the helper bootstraps.\n }\n\n document.documentElement.setAttribute(\"data-inc-theme-mode\", mode);\n document.documentElement.setAttribute(\"data-bs-theme\", resolveTheme(mode));\n document.documentElement.style.colorScheme = resolveTheme(mode);\n })();\n </script>\n <link rel=\"stylesheet\" href=\"./dist/inc-design-language.css\">\n <link rel=\"stylesheet\" href=\"./showcase.css\">\n</head>\n<body>\n <div class=\"inc-app-shell\">\n <header class=\"inc-app-shell__header\">\n <nav class=\"inc-navbar inc-navbar--app inc-navbar--expand-lg\">\n <div class=\"container-fluid\">\n <a class=\"inc-navbar__brand\" href=\"./index.html\">Incursa</a>\n <div class=\"inc-navbar__collapse\">\n <div class=\"inc-navbar__nav\">\n <a class=\"nav-link\" href=\"./index.html\">Examples</a>\n <a class=\"nav-link\" href=\"./demo.html\">Dashboard</a>\n <a class=\"nav-link\" href=\"./work-queue.html\">Work Queue</a>\n <a class=\"nav-link\" href=\"./record-detail.html\">Record Detail</a>\n <a class=\"nav-link\" href=\"./native-patterns.html\">Native Patterns</a>\n <a class=\"nav-link active\" href=\"./overlay-workflows.html\">Overlays</a>\n <a class=\"nav-link\" href=\"./states.html\">States</a>\n <a class=\"nav-link\" href=\"./forms-and-validation.html\">Forms</a>\n <a class=\"nav-link\" href=\"./data-grid-advanced.html\">Data Grid</a>\n <a class=\"nav-link\" href=\"./web-components.html\">Web Components</a>\n <a class=\"nav-link\" href=\"./reference.html\">Reference</a>\n </div>\n <div class=\"inc-navbar__utilities\">\n <div data-inc-theme-switcher data-inc-theme-switcher-variant=\"navbar\"></div>\n <details class=\"inc-native-menu inc-native-menu--navbar\">\n <summary class=\"inc-native-menu__summary\">\n <span class=\"inc-user-menu__avatar\">SM</span>\n <span class=\"inc-user-menu__meta\">\n <span class=\"inc-user-menu__name\">Sam McAravey</span>\n <span class=\"inc-user-menu__detail\">Administrator</span>\n </span>\n </summary>\n <div class=\"inc-native-menu__panel\">\n <div class=\"inc-native-menu__header\">Signed in as Sam McAravey</div>\n <a class=\"inc-native-menu__item\" href=\"#\">Profile</a>\n <a class=\"inc-native-menu__item\" href=\"#\">Preferences</a>\n <a class=\"inc-native-menu__item\" href=\"#\">Sign out</a>\n </div>\n </details>\n </div>\n </div>\n </div>\n </nav>\n <div class=\"inc-nav-triad\">\n <div class=\"inc-nav-triad__container\">\n <div class=\"inc-nav-triad__back\"></div>\n <div class=\"inc-nav-triad__breadcrumb\">\n <ol class=\"inc-breadcrumb\">\n <li class=\"inc-breadcrumb__item\"><a href=\"./index.html\">Examples</a></li>\n <li class=\"inc-breadcrumb__item active\"><span>Overlay Workflows</span></li>\n </ol>\n </div>\n <div class=\"inc-nav-triad__origin\"></div>\n </div>\n </div>\n </header>\n <div class=\"inc-app-shell__body\">\n <div class=\"inc-app-shell__main\">\n <main class=\"inc-app-shell__content\">\n <div class=\"inc-section-container demo-stack\">\n <section class=\"inc-page-header\">\n <div class=\"inc-page-header__title\">\n <p class=\"demo-eyebrow\">Overlay Workflows</p>\n <h1 class=\"inc-heading inc-heading--h1\">Modal and offcanvas examples for operator review flows</h1>\n <p class=\"inc-text inc-text--regular inc-text--muted\">These overlays reuse the same validation, status, and detail primitives as the other workflow pages so they feel like part of the product instead of a separate component library.</p>\n </div>\n <div class=\"inc-page-header__actions\">\n <button class=\"inc-btn inc-btn--primary\" type=\"button\" data-inc-toggle=\"modal\" data-inc-target=\"#approval-modal\">Open approval modal</button>\n <button class=\"inc-btn inc-btn--outline-secondary\" type=\"button\" data-inc-toggle=\"offcanvas\" data-inc-target=\"#assignment-drawer\">Open assignment drawer</button>\n </div>\n </section>\n\n <section class=\"demo-layout-grid demo-layout-grid--2\">\n <article class=\"inc-card\">\n <div class=\"inc-card__header\">\n <h2 class=\"inc-card__title\">When to use a modal</h2>\n </div>\n <div class=\"inc-card__body inc-u-stack-sm\">\n <p class=\"inc-text inc-text--regular\">Use a modal when the user must acknowledge risk, confirm intent, or fix a small amount of blocking information before continuing.</p>\n <div class=\"inc-alert inc-alert--warning\">The approval modal below includes a blocking validation summary and an explicit escalation note.</div>\n <div class=\"demo-chip-row\">\n <span class=\"inc-badge inc-badge--warning inc-badge--pill\">Short task</span>\n <span class=\"inc-badge inc-badge--info inc-badge--pill\">High consequence</span>\n </div>\n </div>\n </article>\n\n <article class=\"inc-card\">\n <div class=\"inc-card__header\">\n <h2 class=\"inc-card__title\">When to use offcanvas</h2>\n </div>\n <div class=\"inc-card__body inc-u-stack-sm\">\n <p class=\"inc-text inc-text--regular\">Use an offcanvas panel when the operator needs to keep surrounding context in view while editing, assigning, or previewing supporting detail.</p>\n <div class=\"inc-toast-card\">\n <div class=\"inc-toast-card__icon\">i</div>\n <div>\n <h3 class=\"inc-toast-card__title\">Keep the grid visible</h3>\n <p class=\"inc-toast-card__text\">Assignment, quick edit, and note-taking generally fit the offcanvas path better than a modal.</p>\n </div>\n </div>\n <div class=\"demo-chip-row\">\n <span class=\"inc-badge inc-badge--success inc-badge--pill\">Context retained</span>\n <span class=\"inc-badge inc-badge--info inc-badge--pill\">Multi-step work</span>\n </div>\n </div>\n </article>\n </section>\n\n <section class=\"inc-card\">\n <div class=\"inc-card__header\">\n <div>\n <h2 class=\"inc-card__title\">Launchable examples</h2>\n <p class=\"inc-text inc-text--small inc-text--muted\">Both buttons below are wired through the package helper in <code>dist/inc-design-language.js</code>.</p>\n </div>\n </div>\n <div class=\"inc-card__body inc-u-stack-md\">\n <div class=\"demo-chip-row\">\n <button class=\"inc-btn inc-btn--primary\" type=\"button\" data-inc-toggle=\"modal\" data-inc-target=\"#approval-modal\">Approve exception</button>\n <button class=\"inc-btn inc-btn--secondary\" type=\"button\" data-inc-toggle=\"offcanvas\" data-inc-target=\"#assignment-drawer\">Assign owner</button>\n </div>\n <div class=\"inc-key-value-grid\">\n <dl class=\"inc-key-value inc-key-value--card\">\n <dt class=\"inc-key-value__label\">Record</dt>\n <dd class=\"inc-key-value__value inc-key-value__value--data\">AP-2026-00142</dd>\n </dl>\n <dl class=\"inc-key-value inc-key-value--card\">\n <dt class=\"inc-key-value__label\">Current owner</dt>\n <dd class=\"inc-key-value__value\">AP Team</dd>\n </dl>\n <dl class=\"inc-key-value inc-key-value--card\">\n <dt class=\"inc-key-value__label\">Blocking issue</dt>\n <dd class=\"inc-key-value__value\">Missing W-9</dd>\n </dl>\n <dl class=\"inc-key-value inc-key-value--card\">\n <dt class=\"inc-key-value__label\">Requested amount</dt>\n <dd class=\"inc-key-value__value inc-key-value__value--data\">$18,240.22</dd>\n </dl>\n </div>\n </div>\n </section>\n </div>\n </main>\n <footer class=\"inc-app-shell__footer inc-footer-bar\">\n <div class=\"inc-footer-bar__meta\">Overlay patterns for approvals, assignments, and secondary review work.</div>\n </footer>\n </div>\n </div>\n </div>\n\n <div id=\"approval-modal\" class=\"inc-modal\" hidden aria-hidden=\"true\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"approval-modal-title\">\n <div class=\"inc-modal__backdrop\">\n <div class=\"inc-modal__dialog inc-modal__dialog--lg\">\n <div class=\"inc-modal__content\">\n <div class=\"inc-modal__header\">\n <div>\n <h2 id=\"approval-modal-title\" class=\"inc-modal__title\">Approve exception</h2>\n <p class=\"inc-text inc-text--small inc-text--muted\">Confirm the exception owner and capture the approval rationale before export continues.</p>\n </div>\n <button class=\"inc-modal__close\" type=\"button\" aria-label=\"Close dialog\" data-inc-dismiss=\"modal\">×</button>\n </div>\n <div class=\"inc-modal__body inc-u-stack-md\">\n <div class=\"inc-form__error-summary\">\n <h3 class=\"inc-form__error-summary-title\">There are 2 issues to resolve first</h3>\n <ul class=\"inc-form__error-summary-list\">\n <li>Approval rationale must be entered.</li>\n <li>An escalation owner must be selected.</li>\n </ul>\n </div>\n\n <div class=\"inc-permission-banner\">\n <div class=\"inc-permission-banner__icon\">!</div>\n <div>\n <h3 class=\"inc-permission-banner__title\">Finance Manager sign-off required</h3>\n <p class=\"inc-permission-banner__text\">Use the modal when the user is about to take a high-consequence action that should pause the surrounding workflow.</p>\n </div>\n </div>\n\n <div class=\"demo-layout-grid demo-layout-grid--2\">\n <div class=\"inc-form__group\">\n <label class=\"inc-form__label inc-form__label--required\" for=\"approval-owner\">Escalation owner</label>\n <select id=\"approval-owner\" class=\"inc-form__select is-invalid\">\n <option selected>Select an owner</option>\n <option>Finance Manager</option>\n <option>Controller</option>\n </select>\n <p class=\"inc-form__feedback inc-form__feedback--error\">Select who will own the exception after approval.</p>\n </div>\n <div class=\"inc-form__group\">\n <label class=\"inc-form__label\" for=\"approval-export-batch\">Export batch</label>\n <input id=\"approval-export-batch\" class=\"inc-form__control\" type=\"text\" value=\"March Closeout 2\">\n </div>\n </div>\n\n <div class=\"inc-form__group\">\n <label class=\"inc-form__label inc-form__label--required\" for=\"approval-rationale\">Approval rationale</label>\n <textarea id=\"approval-rationale\" class=\"inc-form__control is-invalid\" rows=\"4\" placeholder=\"Explain why the exception can move forward.\"></textarea>\n <p class=\"inc-form__feedback inc-form__feedback--error\">A short explanation is required for audit history.</p>\n </div>\n </div>\n <div class=\"inc-modal__footer\">\n <button class=\"inc-btn inc-btn--outline-secondary\" type=\"button\" data-inc-dismiss=\"modal\">Cancel</button>\n <button class=\"inc-btn inc-btn--primary\" type=\"button\">Approve Exception</button>\n </div>\n </div>\n </div>\n </div>\n </div>\n\n <div class=\"inc-offcanvas-backdrop\" data-inc-backdrop-for=\"assignment-drawer\" hidden></div>\n <aside id=\"assignment-drawer\" class=\"inc-offcanvas inc-offcanvas-end\" aria-hidden=\"true\" aria-labelledby=\"assignment-drawer-title\">\n <div class=\"inc-offcanvas-header\">\n <div class=\"inc-u-stack-xs\">\n <h2 id=\"assignment-drawer-title\" class=\"inc-offcanvas-title\">Assign review owner</h2>\n <p class=\"inc-text inc-text--small inc-text--muted\">Offcanvas keeps the surrounding queue visible while the operator routes work.</p>\n </div>\n <button class=\"inc-modal__close\" type=\"button\" aria-label=\"Close panel\" data-inc-dismiss=\"offcanvas\">×</button>\n </div>\n <div class=\"inc-offcanvas-body inc-u-stack-md\">\n <div class=\"inc-key-value-grid\">\n <dl class=\"inc-key-value\">\n <dt class=\"inc-key-value__label\">Record</dt>\n <dd class=\"inc-key-value__value inc-key-value__value--data\">AP-2026-00142</dd>\n </dl>\n <dl class=\"inc-key-value\">\n <dt class=\"inc-key-value__label\">Current owner</dt>\n <dd class=\"inc-key-value__value\">AP Team</dd>\n </dl>\n <dl class=\"inc-key-value\">\n <dt class=\"inc-key-value__label\">State</dt>\n <dd class=\"inc-key-value__value\">Needs Review</dd>\n </dl>\n <dl class=\"inc-key-value\">\n <dt class=\"inc-key-value__label\">Requested amount</dt>\n <dd class=\"inc-key-value__value inc-key-value__value--data\">$18,240.22</dd>\n </dl>\n </div>\n\n <div class=\"inc-filter-bar\">\n <div class=\"inc-filter-bar__main\">\n <div class=\"inc-filter-bar__field inc-filter-bar__field--grow\">\n <label class=\"inc-form__label\" for=\"assignment-search\">Search owner</label>\n <input id=\"assignment-search\" class=\"inc-form__control inc-form__control--sm\" type=\"text\" value=\"legal\">\n </div>\n <div class=\"inc-filter-bar__field\">\n <label class=\"inc-form__label\" for=\"assignment-team\">Queue</label>\n <select id=\"assignment-team\" class=\"inc-form__select inc-form__select--sm\">\n <option>AP Team</option>\n <option selected>Legal Review</option>\n <option>Compliance</option>\n </select>\n </div>\n </div>\n <div class=\"inc-filter-bar__chips\">\n <span class=\"inc-filter-chip inc-filter-chip--accent\">Priority: Exception <button class=\"inc-filter-chip__remove\" type=\"button\" aria-label=\"Remove filter\">×</button></span>\n <span class=\"inc-filter-chip\">SLA: 24 hours <button class=\"inc-filter-chip__remove\" type=\"button\" aria-label=\"Remove filter\">×</button></span>\n </div>\n </div>\n\n <div class=\"inc-form__group\">\n <label class=\"inc-form__label\" for=\"assignment-note\">Routing note</label>\n <textarea id=\"assignment-note\" class=\"inc-form__control\" rows=\"4\">Assign to Legal Review so they can validate the incoming W-9 and insurance certificate before export.</textarea>\n </div>\n\n <div class=\"inc-toast-card\">\n <div class=\"inc-toast-card__icon\">i</div>\n <div>\n <h3 class=\"inc-toast-card__title\">Why offcanvas works here</h3>\n <p class=\"inc-toast-card__text\">This task needs context, but it should not block the whole screen the way an approval modal does.</p>\n </div>\n </div>\n\n <div class=\"demo-chip-row\">\n <button class=\"inc-btn inc-btn--outline-secondary\" type=\"button\" data-inc-dismiss=\"offcanvas\">Cancel</button>\n <button class=\"inc-btn inc-btn--secondary\" type=\"button\">Save Draft</button>\n <button class=\"inc-btn inc-btn--primary\" type=\"button\">Assign Owner</button>\n </div>\n </div>\n </aside>\n\n <script src=\"./dist/inc-design-language.js\"></script>\n</body>\n</html>\n\noverlay-workflows.html\noverlay-workflows-html\noverlay-workflows.html"
    },
