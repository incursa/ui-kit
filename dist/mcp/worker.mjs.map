      "searchText": "web-components.html\nRaw curated file content for web-components.html.\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n <meta charset=\"utf-8\">\n <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n <title>Incursa UI Kit - Web Components</title>\n <script>\n (() => {\n const storageKey = \"inc-theme-mode\";\n const resolveTheme = (mode) => mode === \"dark\" || mode === \"light\"\n ? mode\n : (window.matchMedia && window.matchMedia(\"(prefers-color-scheme: dark)\").matches ? \"dark\" : \"light\");\n let mode = \"system\";\n\n try {\n const storedMode = window.localStorage.getItem(storageKey);\n\n if (storedMode === \"light\" || storedMode === \"dark\" || storedMode === \"system\") {\n mode = storedMode;\n }\n } catch {\n // Ignore storage restrictions before the component runtime bootstraps.\n }\n\n document.documentElement.setAttribute(\"data-inc-theme-mode\", mode);\n document.documentElement.setAttribute(\"data-bs-theme\", resolveTheme(mode));\n document.documentElement.style.colorScheme = resolveTheme(mode);\n })();\n </script>\n <link rel=\"stylesheet\" href=\"./dist/inc-design-language.css\">\n <link rel=\"stylesheet\" href=\"./showcase.css\">\n <style>\n :root {\n --wc-showcase-radius: var(--demo-surface-radius);\n }\n\n body {\n color: var(--inc-text-primary);\n }\n\n .wc-showcase {\n display: grid;\n gap: 1.25rem;\n }\n\n .wc-hero {\n display: grid;\n gap: 1rem;\n align-items: start;\n }\n\n .wc-grid {\n display: grid;\n gap: 1rem;\n align-items: start;\n }\n\n .wc-grid--2 {\n grid-template-columns: repeat(2, minmax(0, 1fr));\n }\n\n .wc-grid--3 {\n grid-template-columns: repeat(3, minmax(0, 1fr));\n }\n\n .wc-note {\n color: var(--inc-text-muted);\n margin: 0;\n }\n\n .wc-code {\n background: var(--demo-surface-muted);\n border: 1px solid var(--demo-border);\n border-radius: var(--wc-showcase-radius);\n padding: 1rem;\n overflow: auto;\n color: var(--inc-text-primary);\n }\n\n .demo-compare__panel {\n border-radius: var(--wc-showcase-radius);\n }\n\n .demo-muted-panel,\n .demo-preview,\n .demo-surface-muted {\n border-radius: var(--wc-showcase-radius);\n }\n\n .demo-code {\n border-radius: var(--wc-showcase-radius);\n }\n\n .demo-swatch {\n border-radius: var(--wc-showcase-radius);\n }\n\n .wc-tabs {\n display: grid;\n gap: 0.75rem;\n }\n\n .wc-tabs [slot=\"tab\"] {\n appearance: none;\n border: 1px solid var(--inc-border-subtle);\n background: var(--inc-surface-secondary);\n color: var(--inc-text-secondary);\n border-radius: 0.5rem;\n padding: 0.65rem 0.9rem;\n }\n\n .wc-tabs [slot=\"tab\"][aria-selected=\"true\"] {\n background: var(--inc-surface-primary);\n color: var(--inc-text-primary);\n font-weight: 600;\n }\n\n .wc-tabs [slot=\"panel\"][hidden] {\n display: none !important;\n }\n\n .wc-actions {\n display: flex;\n flex-wrap: wrap;\n gap: 0.75rem;\n align-items: flex-start;\n }\n\n #wc-navbar {\n flex-wrap: nowrap;\n }\n\n #wc-navbar .inc-navbar__nav {\n flex: 1 1 auto;\n min-width: 0;\n overflow-x: auto;\n overflow-y: hidden;\n scrollbar-width: none;\n }\n\n #wc-navbar .inc-navbar__nav::-webkit-scrollbar {\n display: none;\n }\n\n #wc-navbar .inc-navbar__nav .nav-link,\n #wc-navbar .inc-navbar__nav .inc-nav-link {\n flex: 0 0 auto;\n white-space: nowrap;\n }\n\n @media (max-width: 900px) {\n .wc-grid--2,\n .wc-grid--3 {\n grid-template-columns: 1fr;\n }\n }\n </style>\n</head>\n<body>\n <inc-app-shell id=\"wc-shell\" class=\"inc-app-shell\" variant=\"demo\">\n <header slot=\"header\" class=\"inc-app-shell__header\">\n <inc-navbar id=\"wc-navbar\" app breakpoint=\"lg\">\n <a slot=\"brand\" class=\"inc-navbar__brand\" href=\"#wc-home\">Incursa</a>\n <div slot=\"nav\" class=\"inc-navbar__nav\">\n <a class=\"nav-link\" href=\"./index.html\">Examples</a>\n <a class=\"nav-link\" href=\"./demo.html\">Dashboard</a>\n <a class=\"nav-link\" href=\"./work-queue.html\">Work Queue</a>\n <a class=\"nav-link\" href=\"./record-detail.html\">Record Detail</a>\n <a class=\"nav-link\" href=\"./native-patterns.html\">Native Patterns</a>\n <a class=\"nav-link\" href=\"./overlay-workflows.html\">Overlays</a>\n <a class=\"nav-link\" href=\"./states.html\">States</a>\n <a class=\"nav-link\" href=\"./forms-and-validation.html\">Forms</a>\n <a class=\"nav-link\" href=\"./data-grid-advanced.html\">Data Grid</a>\n <a class=\"nav-link active\" href=\"./web-components.html\">Web Components</a>\n <a class=\"nav-link\" href=\"./reference.html\">Reference</a>\n </div>\n <div slot=\"utilities\" class=\"inc-navbar__utilities\">\n <inc-theme-switcher id=\"wc-theme-switcher\" variant=\"navbar\" block label=\"Theme\" menu-label=\"Theme menu\" heading=\"Choose appearance\"></inc-theme-switcher>\n <details class=\"inc-native-menu inc-native-menu--navbar\">\n <summary class=\"inc-native-menu__summary\">\n <span class=\"inc-user-menu__avatar\">SM</span>\n <span class=\"inc-user-menu__meta\">\n <span class=\"inc-user-menu__name\">Sam McAravey</span>\n <span class=\"inc-user-menu__detail\">Administrator</span>\n </span>\n </summary>\n <div class=\"inc-native-menu__panel\">\n <div class=\"inc-native-menu__header\">Signed in as Sam McAravey</div>\n <a class=\"inc-native-menu__item\" href=\"#\">Profile</a>\n <a class=\"inc-native-menu__item\" href=\"#\">Preferences</a>\n <a class=\"inc-native-menu__item\" href=\"#\">Sign out</a>\n </div>\n </details>\n </div>\n <div slot=\"collapse\" class=\"inc-navbar__collapse\">\n <button id=\"wc-navbar-toggle\" class=\"inc-navbar__toggler inc-btn inc-btn--outline-secondary inc-btn--sm\" type=\"button\" data-inc-navbar-toggle>\n Menu\n </button>\n </div>\n </inc-navbar>\n </header>\n\n <main slot=\"main\" class=\"inc-app-shell__main\">\n <div class=\"inc-section-container\">\n <inc-page id=\"wc-page\" class=\"inc-page\">\n <div slot=\"breadcrumbs\" class=\"inc-page__breadcrumbs\">\n <ol class=\"inc-breadcrumb\">\n <li class=\"inc-breadcrumb__item\"><a href=\"#wc-home\">Examples</a></li>\n <li class=\"inc-breadcrumb__item active\"><span>Web Components</span></li>\n </ol>\n </div>\n\n <inc-page-header slot=\"header\" id=\"wc-header\" class=\"inc-page-header\">\n <div slot=\"title\" class=\"wc-hero\">\n <p class=\"demo-eyebrow\">Optional Layer</p>\n <h1 class=\"inc-heading inc-heading--h1\">Browser-native components that stay inside the same CSS kit.</h1>\n <p class=\"inc-text inc-text--regular inc-text--muted\">Use the class-based UI kit when you only need the language. Use the Web Component layer when you want declarative HTML, attributes, slots, DOM events, and the same design vocabulary from plain browser markup.</p>\n </div>\n <div slot=\"actions\" class=\"wc-actions\">\n <a class=\"inc-btn inc-btn--secondary inc-btn--sm\" href=\"./README.md\">Read the package docs</a>\n <a class=\"inc-btn inc-btn--primary inc-btn--sm\" href=\"./src/web-components/README.md\">Read the maintainer notes</a>\n </div>\n </inc-page-header>\n\n <section slot=\"body\" id=\"wc-home\" class=\"wc-showcase\">\n <inc-card class=\"inc-card inc-card--elevated\" elevated>\n <div slot=\"header\" class=\"inc-card__header\">\n <h2 class=\"inc-card__title\">Load the entrypoints</h2>\n </div>\n <div slot=\"body\" class=\"wc-grid wc-grid--2\">\n <div>\n <p class=\"inc-text inc-text--regular\">The package export is `@incursa/ui-kit/web-components`. Pair it with `@incursa/ui-kit/web-components/style.css` for the default look, then import the runtime once to register the shipped elements.</p>\n <pre class=\"wc-code\"><code>&lt;link rel=\"stylesheet\" href=\"/node_modules/@incursa/ui-kit/web-components/style.css\"&gt;\n&lt;script type=\"module\"&gt;\n import \"@incursa/ui-kit/web-components\";\n&lt;/script&gt;</code></pre>\n </div>\n <div>\n <p class=\"wc-note\">The v1 layer covers layouts, navbar/tabs/user-menu, field/input-group/choice-group/readonly-field/validation-summary, state/live-region/auto-refresh/theme-switcher, button/button-group/button-toolbar/close-button, alert/empty-state/list-group/key-value hosts, badge/spinner atoms, and disclosure/dialog/drawer.</p>\n <p class=\"wc-note\">Tables and the remaining data presentation surfaces, filters, bulk workflows, files, utilities, and most other presentation-only atoms stay CSS-first for now.</p>\n </div>\n </div>\n </inc-card>\n\n <section id=\"wc-comparison\" class=\"demo-compare demo-compare--2\">\n <article class=\"demo-compare__panel\">\n <p class=\"demo-eyebrow\">Plain HTML equivalent</p>\n <h2 class=\"demo-compare__title inc-heading inc-heading--h3\">Explicit class wiring</h2>\n <p class=\"demo-compare__copy\">This is the CSS-first version of the same screen shape. It works, but the structure is louder because every wrapper is spelled out by hand.</p>\n <pre class=\"demo-code\"><code>&lt;section class=\"inc-card\"&gt;\n &lt;div class=\"inc-card__header\"&gt;\n &lt;h2 class=\"inc-card__title\"&gt;Queue summary&lt;/h2&gt;\n &lt;/div&gt;\n &lt;div class=\"inc-card__body\"&gt;\n &lt;table class=\"inc-table inc-table--sm inc-table--data-table\"&gt;\n &lt;thead&gt;...&lt;/thead&gt;\n &lt;tbody&gt;...&lt;/tbody&gt;\n &lt;/table&gt;\n &lt;/div&gt;\n&lt;/section&gt;</code></pre>\n </article>\n\n <article class=\"demo-compare__panel\">\n <p class=\"demo-eyebrow\">Web Components equivalent</p>\n <h2 class=\"demo-compare__title inc-heading inc-heading--h3\">Shorter markup, same result</h2>\n <p class=\"demo-compare__copy\">The Web Component layer lets the browser own the semantics while the slots keep the layout contract obvious and reusable.</p>\n <pre class=\"demo-code\"><code>&lt;inc-card elevated&gt;\n &lt;div slot=\"header\" class=\"inc-card__header\"&gt;\n &lt;h2 class=\"inc-card__title\"&gt;Queue summary&lt;/h2&gt;\n &lt;/div&gt;\n &lt;div slot=\"body\"&gt;\n &lt;table class=\"inc-table inc-table--sm inc-table--data-table\"&gt;\n &lt;thead&gt;...&lt;/thead&gt;\n &lt;tbody&gt;...&lt;/tbody&gt;\n &lt;/table&gt;\n &lt;/div&gt;\n&lt;/inc-card&gt;</code></pre>\n </article>\n </section>\n\n <inc-card id=\"wc-shell-metrics\" class=\"inc-card\">\n <div slot=\"header\" class=\"inc-card__header\">\n <h2 class=\"inc-card__title\">Shell, navigation, and metrics</h2>\n </div>\n <div slot=\"body\" class=\"wc-grid wc-grid--2\">\n <inc-summary-overview class=\"inc-summary-overview inc-summary-overview--3-col\" columns=\"3\">\n <inc-summary-block class=\"inc-summary-block\">\n <div slot=\"header\">Queue</div>\n <div slot=\"body\"><strong>124</strong></div>\n <div slot=\"footer\">Pending review</div>\n </inc-summary-block>\n <inc-summary-block class=\"inc-summary-block inc-summary-block--tone-warning\" tone=\"warning\">\n <div slot=\"header\">Risks</div>\n <div slot=\"body\"><strong>7</strong></div>\n <div slot=\"footer\">Needs attention</div>\n </inc-summary-block>\n <inc-summary-block class=\"inc-summary-block inc-summary-block--tone-positive\" tone=\"positive\">\n <div slot=\"header\">Saved</div>\n <div slot=\"body\"><strong>$18.2k</strong></div>\n <div slot=\"footer\">This week</div>\n </inc-summary-block>\n </inc-summary-overview>\n <inc-tabs id=\"wc-tabs\" orientation=\"horizontal\" activation=\"auto\" selected=\"wc-tab-review\">\n <button slot=\"tab\" id=\"wc-tab-review\" type=\"button\" class=\"inc-tab\" aria-controls=\"wc-panel-review\">Needs Review</button>\n <button slot=\"tab\" id=\"wc-tab-ready\" type=\"button\" class=\"inc-tab\" aria-controls=\"wc-panel-ready\">Ready To Approve</button>\n <button slot=\"tab\" id=\"wc-tab-exported\" type=\"button\" class=\"inc-tab\" aria-controls=\"wc-panel-exported\">Recently Exported</button>\n <section slot=\"panel\" id=\"wc-panel-review\" class=\"inc-tab-pane\">Review queue content.</section>\n <section slot=\"panel\" id=\"wc-panel-ready\" class=\"inc-tab-pane\">Ready-to-approve content.</section>\n <section slot=\"panel\" id=\"wc-panel-exported\" class=\"inc-tab-pane\">Recently exported content.</section>\n </inc-tabs>\n </div>\n </inc-card>\n\n <inc-card id=\"wc-atomic-controls\" class=\"inc-card\">\n <div slot=\"header\" class=\"inc-card__header\">\n <h2 class=\"inc-card__title\">Atomic controls with stable defaults</h2>\n </div>\n <div slot=\"body\" class=\"wc-grid wc-grid--2\">\n <div class=\"inc-stack inc-stack--gap-sm\">\n <p class=\"wc-note\">Badge hosts standardize tone and pill styling without making you memorize the class suffix chain.</p>\n <div class=\"wc-actions\">\n <inc-badge id=\"wc-badge-default\">Draft</inc-badge>\n <inc-badge id=\"wc-badge-success\" tone=\"success\" pill>Approved</inc-badge>\n <inc-badge id=\"wc-badge-warning\" tone=\"warning\">Pending</inc-badge>\n </div>\n </div>\n <div class=\"inc-stack inc-stack--gap-sm\">\n <p class=\"wc-note\">Spinner hosts standardize loading variants and accessible labels.</p>\n <div class=\"wc-actions\">\n <inc-spinner id=\"wc-spinner-border\" label=\"Loading queue\"></inc-spinner>\n <inc-spinner id=\"wc-spinner-grow\" variant=\"grow\" tone=\"primary\" size=\"sm\" label=\"Refreshing\"></inc-spinner>\n </div>\n </div>\n </div>\n </inc-card>\n\n <inc-card id=\"wc-action-shells\" class=\"inc-card\">\n <div slot=\"header\" class=\"inc-card__header\">\n <h2 class=\"inc-card__title\">Buttons, alerts, and empty states</h2>\n </div>\n <div slot=\"body\" class=\"wc-grid wc-grid--2\">\n <div class=\"inc-stack inc-stack--gap-sm\">\n <p class=\"wc-note\">Button hosts wrap native controls and standardize tone, size, and loading defaults.</p>\n <div class=\"wc-actions\">\n <inc-button id=\"wc-button-primary\" tone=\"primary\">Approve</inc-button>\n <inc-button id=\"wc-button-secondary\" tone=\"secondary\" size=\"sm\">Save Draft</inc-button>\n <inc-button id=\"wc-button-loading\" tone=\"outline-secondary\" loading label=\"Saving approval\">Saving</inc-button>\n </div>\n <div class=\"wc-actions\">\n <inc-button id=\"wc-button-inline-loading\" tone=\"primary\" size=\"sm\" label=\"Publishing approval\">\n <span class=\"inc-spinner inc-spinner--border inc-spinner--border--sm\" aria-hidden=\"true\"></span>\n <span>Publishing</span>\n </inc-button>\n <inc-button id=\"wc-button-inline-loading-secondary\" variant=\"outline-secondary\" size=\"sm\" label=\"Refreshing queue\">\n <span class=\"inc-spinner inc-spinner--border inc-spinner--border--sm\" aria-hidden=\"true\"></span>\n <span>Refreshing</span>\n </inc-button>\n </div>\n <inc-button-group id=\"wc-button-group\" size=\"sm\" label=\"Queue mode\">\n <inc-button tone=\"secondary\">Light</inc-button>\n <inc-button tone=\"secondary\">Dark</inc-button>\n <inc-button tone=\"secondary\">System</inc-button>\n </inc-button-group>\n <inc-button-toolbar id=\"wc-button-toolbar\" label=\"Quick actions\">\n <inc-button tone=\"secondary\" size=\"sm\">Refresh</inc-button>\n <inc-button tone=\"primary\" size=\"sm\">Export</inc-button>\n <inc-close-button id=\"wc-close-button\" label=\"Dismiss panel\"></inc-close-button>\n </inc-button-toolbar>\n </div>\n <div class=\"inc-stack inc-stack--gap-sm\">\n <p class=\"wc-note\">Alerts and empty-state shells keep the repeated runtime scaffolding declarative.</p>\n <inc-alert id=\"wc-alert-success\" tone=\"success\" dismissible dismiss-label=\"Dismiss success\" timeout=\"5000\">Success alert text.</inc-alert>\n <inc-alert id=\"wc-alert-info\" tone=\"info\">Information alert text.</inc-alert>\n <inc-alert id=\"wc-alert-warning\" tone=\"warning\" dismissible dismiss-label=\"Dismiss warning\">Warning alert text.</inc-alert>\n <inc-empty-state id=\"wc-empty-state\">\n <span slot=\"icon\">+</span>\n <h3 class=\"inc-heading inc-heading--h3\">No saved views</h3>\n <p class=\"inc-text inc-text--regular inc-text--muted\">Create a named filter set so your operators can reuse it across screens.</p>\n <div slot=\"actions\" class=\"wc-actions\">\n <inc-button tone=\"secondary\" size=\"sm\">Dismiss</inc-button>\n <inc-button tone=\"primary\" size=\"sm\">Create View</inc-button>\n </div>\n </inc-empty-state>\n </div>\n </div>\n </inc-card>\n\n <inc-card id=\"wc-collection-shells\" class=\"inc-card\">\n <div slot=\"header\" class=\"inc-card__header\">\n <h2 class=\"inc-card__title\">List groups and key values</h2>\n </div>\n <div slot=\"body\" class=\"wc-grid wc-grid--2\">\n <div class=\"inc-stack inc-stack--gap-sm\">\n <p class=\"wc-note\">List-group hosts standardize repeated action-row markup without changing list semantics.</p>\n <inc-list-group id=\"wc-list-group\" label=\"Saved views\">\n <a slot=\"item\" href=\"#\">Needs review</a>\n <a slot=\"item\" href=\"#\">March closeout</a>\n <a slot=\"item\" href=\"#\">Projects missing billing period</a>\n </inc-list-group>\n <inc-list-group id=\"wc-numbered-list-group\" numbered label=\"Review steps\">\n <li slot=\"item\">First review pass</li>\n <li slot=\"item\">Secondary approval</li>\n <li slot=\"item\">Final export</li>\n </inc-list-group>\n </div>\n <div class=\"inc-stack inc-stack--gap-sm\">\n <p class=\"wc-note\">Key-value hosts standardize the repeated description-list pair pattern.</p>\n <inc-key-value-grid id=\"wc-key-value-grid\" columns=\"2\">\n <inc-key-value id=\"wc-key-value-record\" label=\"Record Id\" value=\"AP-2026-00142\" meta=\"Synced 8:13 AM\" card></inc-key-value>\n <inc-key-value id=\"wc-key-value-amount\" label=\"Current request\" value=\"$18,240.22\" card></inc-key-value>\n </inc-key-value-grid>\n </div>\n </div>\n </inc-card>\n\n <inc-card id=\"wc-data-presentation\" class=\"inc-card\">\n <div slot=\"header\" class=\"inc-card__header\">\n <h2 class=\"inc-card__title\">Tables, colors, and low-level presentation stay CSS-first</h2>\n </div>\n <div slot=\"body\" class=\"wc-grid wc-grid--2\">\n <div class=\"inc-stack inc-stack--gap-sm\">\n <p class=\"wc-note\">The Web Component layer does not replace the table styling language. It reuses the same class-based table system where that is still the right contract.</p>\n <table class=\"inc-table inc-table--sm inc-table--data-table\">\n <thead>\n <tr>\n <th class=\"inc-table__header\">Project</th>\n <th class=\"inc-table__header\">Period</th>\n <th class=\"inc-table__header inc-table__header--right\">Amount</th>\n <th class=\"inc-table__header\">Status</th>\n </tr>\n </thead>\n <tbody>\n <tr>\n <td class=\"inc-table__cell inc-table__cell--data\">AP-2026-00142</td>\n <td class=\"inc-table__cell\">March 2026</td>\n <td class=\"inc-table__cell inc-table__cell--numeric\">$18,240.22</td>\n <td class=\"inc-table__cell\"><span class=\"inc-badge inc-badge--success inc-badge--pill\">Approved</span></td>\n </tr>\n <tr>\n <td class=\"inc-table__cell inc-table__cell--data\">AP-2026-00144</td>\n <td class=\"inc-table__cell\">March 2026</td>\n <td class=\"inc-table__cell inc-table__cell--numeric\">$4,992.00</td>\n <td class=\"inc-table__cell\"><span class=\"inc-badge inc-badge--warning inc-badge--pill\">Pending</span></td>\n </tr>\n </tbody>\n </table>\n </div>\n <div class=\"inc-stack inc-stack--gap-sm\">\n <p class=\"wc-note\">The color story and compact action buttons still match the CSS-first kit exactly.</p>\n <div class=\"demo-swatch-grid\">\n <div class=\"demo-swatch demo-swatch--on-dark\" style=\"background: var(--bs-primary); border-color: transparent;\">\n <span class=\"demo-swatch__token\">Primary</span>\n <span class=\"demo-swatch__name\">Action color</span>\n <span class=\"demo-swatch__value\">var(--bs-primary)</span>\n </div>\n <div class=\"demo-swatch demo-swatch--warning\" style=\"background: rgb(198, 136, 0); border-color: transparent;\">\n <span class=\"demo-swatch__token\">Warning</span>\n <span class=\"demo-swatch__name\">Attention state</span>\n <span class=\"demo-swatch__value\">var(--bs-warning)</span>\n </div>\n <div class=\"demo-swatch demo-swatch--on-dark\" style=\"background: var(--bs-danger); border-color: transparent;\">\n <span class=\"demo-swatch__token\">Danger</span>\n <span class=\"demo-swatch__name\">High-risk state</span>\n <span class=\"demo-swatch__value\">var(--bs-danger)</span>\n </div>\n <div class=\"demo-swatch demo-swatch--surface\" style=\"background: var(--inc-surface-secondary);\">\n <span class=\"demo-swatch__token\">Surface</span>\n <span class=\"demo-swatch__name\">Neutral panel</span>\n <span class=\"demo-swatch__value\">var(--inc-surface-secondary)</span>\n </div>\n </div>\n <div class=\"wc-actions\">\n <button class=\"inc-btn inc-btn--secondary inc-btn--sm\" type=\"button\">Secondary</button>\n <button class=\"inc-btn inc-btn--primary inc-btn--sm\" type=\"button\">Primary</button>\n <button class=\"inc-btn inc-btn--outline-secondary inc-btn--sm\" type=\"button\">Outline</button>\n </div>\n </div>\n </div>\n </inc-card>\n\n <inc-card class=\"inc-card\">\n <div slot=\"header\" class=\"inc-card__header\">\n <h2 class=\"inc-card__title\">Forms and feedback</h2>\n </div>\n <div slot=\"body\" class=\"wc-grid wc-grid--2\">\n <inc-field label=\"Project name\" hint=\"Visible to operators\" error=\"Project name is required.\" required invalid>\n <label slot=\"label\" class=\"inc-form__label\" for=\"project-name\">Project name</label>\n <input slot=\"control\" id=\"project-name\" type=\"text\" value=\"North Campus Expansion\">\n <p slot=\"hint\">Visible to operators.</p>\n <p slot=\"error\">Project name is required.</p>\n </inc-field>\n <inc-input-group prefix=\"$\" suffix=\"USD\" dense expand>\n <span slot=\"prefix\" class=\"inc-input-group__text\">$</span>\n <input slot=\"control\" type=\"text\" value=\"18240.22\">\n <span slot=\"suffix\" class=\"inc-input-group__text\">USD</span>\n </inc-input-group>\n <inc-choice-group legend=\"Approval route\" hint=\"Choose one\">\n <legend slot=\"legend\">Approval route</legend>\n <div slot=\"item\" class=\"inc-form__check\">\n <input id=\"route-fast\" name=\"route\" type=\"radio\" checked>\n <label for=\"route-fast\">Fast approval</label>\n </div>\n <div slot=\"item\" class=\"inc-form__check\">\n <input id=\"route-standard\" name=\"route\" type=\"radio\">\n <label for=\"route-standard\">Standard approval</label>\n </div>\n </inc-choice-group>\n <inc-validation-summary count=\"2\" live=\"polite\">\n <ul>\n <li slot=\"item\"><a href=\"#project-name\">Project name is required.</a></li>\n <li slot=\"item\"><a href=\"#route-standard\">Approval owner missing.</a></li>\n </ul>\n </inc-validation-summary>\n <inc-readonly-field label=\"Record ID\" value=\"AP-2026-00142\">\n <span slot=\"meta\">Synced 8:13 AM</span>\n </inc-readonly-field>\n <inc-live-region id=\"wc-live-region\" politeness=\"polite\" atomic=\"true\">Ready for status announcements.</inc-live-region>\n </div>\n </inc-card>\n\n <inc-card class=\"inc-card\">\n <div slot=\"header\" class=\"inc-card__header\">\n <h2 class=\"inc-card__title\">Overlays and disclosures</h2>\n </div>\n <div slot=\"body\" class=\"wc-actions\">\n <button id=\"open-dialog\" class=\"inc-btn inc-btn--primary\" type=\"button\">Open dialog</button>\n <button id=\"open-drawer\" class=\"inc-btn inc-btn--secondary\" type=\"button\">Open drawer</button>\n <inc-disclosure id=\"wc-disclosure\" summary=\"Review notes\" open>\n <div slot=\"content\">\n <p class=\"inc-text inc-text--regular\">Disclosure content stays native-details based in the WC layer.</p>\n </div>\n </inc-disclosure>\n </div>\n </inc-card>\n </section>\n </inc-page>\n </div>\n </main>\n\n <footer slot=\"footer\" class=\"inc-footer-bar inc-app-shell__footer\">\n <div class=\"inc-footer-bar__menu\">\n <a class=\"inc-btn inc-btn--secondary\" href=\"./reference.html\">Copy CSS reference</a>\n <a class=\"inc-btn inc-btn--primary\" href=\"./specs/architecture/ui-kit/ARC-UIK-0002.md\">Read the architecture</a>\n </div>\n <div class=\"inc-footer-bar__meta\">Optional WC layer, same package, same design vocabulary. Open demo.html beside this page to compare the condensed custom-element markup with the CSS-first baseline.</div>\n </footer>\n </inc-app-shell>\n\n <inc-dialog id=\"wc-dialog\" label=\"Approval dialog\" modal dismissible size=\"lg\">\n <div slot=\"title\">Approve exception</div>\n <div slot=\"body\" class=\"wc-grid wc-grid--2\">\n <inc-validation-summary count=\"1\" live=\"assertive\">\n <ul>\n <li slot=\"item\"><a href=\"#dialog-rationale\">Approval rationale is 