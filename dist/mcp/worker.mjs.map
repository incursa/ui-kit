  {
    "uri": "ui-kit://guides/choose-css-vs-scss-vs-js-vs-web-components",
    "title": "Choose CSS vs SCSS vs JS vs web components",
    "kind": "guide",
    "summary": "Decision tree for the package entrypoints and helper surfaces.",
    "sourcePaths": [
      "README.md",
