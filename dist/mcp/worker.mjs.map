      "searchText": "reference.html\nRaw curated file content for reference.html.\n<!DOCTYPE html>\n<html lang=\"en\" data-bs-theme=\"light\">\n<head>\n <meta charset=\"utf-8\">\n <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n <title>Incursa Design Language Showcase - Reference</title>\n <script>\n (() => {\n const storageKey = \"inc-theme-mode\";\n const resolveTheme = (mode) => mode === \"dark\" || mode === \"light\"\n ? mode\n : (window.matchMedia && window.matchMedia(\"(prefers-color-scheme: dark)\").matches ? \"dark\" : \"light\");\n let mode = \"system\";\n\n try {\n const storedMode = window.localStorage.getItem(storageKey);\n\n if (storedMode === \"light\" || storedMode === \"dark\" || storedMode === \"system\") {\n mode = storedMode;\n }\n } catch {\n // Ignore storage restrictions before the helper bootstraps.\n }\n\n document.documentElement.setAttribute(\"data-inc-theme-mode\", mode);\n document.documentElement.setAttribute(\"data-bs-theme\", resolveTheme(mode));\n document.documentElement.style.colorScheme = resolveTheme(mode);\n })();\n </script>\n <link rel=\"stylesheet\" href=\"./dist/inc-design-language.css\">\n <link rel=\"stylesheet\" href=\"./showcase.css\">\n</head>\n<body>\n <div class=\"inc-app-shell\">\n <header class=\"inc-app-shell__header\">\n <nav class=\"inc-navbar inc-navbar--app inc-navbar--expand-lg\">\n <div class=\"container-fluid\">\n <a class=\"inc-navbar__brand\" href=\"./index.html\">Incursa</a>\n <div class=\"inc-navbar__collapse\">\n <div class=\"inc-navbar__nav\">\n <a class=\"nav-link\" href=\"./index.html\">Examples</a>\n <a class=\"nav-link\" href=\"./demo.html\">Dashboard</a>\n <a class=\"nav-link\" href=\"./work-queue.html\">Work Queue</a>\n <a class=\"nav-link\" href=\"./record-detail.html\">Record Detail</a>\n <a class=\"nav-link\" href=\"./native-patterns.html\">Native Patterns</a>\n <a class=\"nav-link\" href=\"./overlay-workflows.html\">Overlays</a>\n <a class=\"nav-link\" href=\"./states.html\">States</a>\n <a class=\"nav-link\" href=\"./forms-and-validation.html\">Forms</a>\n <a class=\"nav-link\" href=\"./data-grid-advanced.html\">Data Grid</a>\n <a class=\"nav-link\" href=\"./web-components.html\">Web Components</a>\n <a class=\"nav-link active\" href=\"./reference.html\">Reference</a>\n </div>\n <div class=\"inc-navbar__utilities\">\n <div data-inc-theme-switcher data-inc-theme-switcher-variant=\"navbar\"></div>\n <details class=\"inc-native-menu inc-native-menu--navbar\">\n <summary class=\"inc-native-menu__summary\">\n <span class=\"inc-user-menu__avatar\">SM</span>\n <span class=\"inc-user-menu__meta\">\n <span class=\"inc-user-menu__name\">Sam McAravey</span>\n <span class=\"inc-user-menu__detail\">Administrator</span>\n </span>\n </summary>\n <div class=\"inc-native-menu__panel\">\n <div class=\"inc-native-menu__header\">Signed in as Sam McAravey</div>\n <a class=\"inc-native-menu__item\" href=\"#\">Profile</a>\n <a class=\"inc-native-menu__item\" href=\"#\">Preferences</a>\n <a class=\"inc-native-menu__item\" href=\"#\">Sign out</a>\n </div>\n </details>\n </div>\n </div>\n </div>\n </nav>\n <div class=\"inc-nav-triad\">\n <div class=\"inc-nav-triad__container\">\n <div class=\"inc-nav-triad__back\"></div>\n <div class=\"inc-nav-triad__breadcrumb\">\n <ol class=\"inc-breadcrumb\">\n <li class=\"inc-breadcrumb__item\"><a href=\"./index.html\">Examples</a></li>\n <li class=\"inc-breadcrumb__item active\"><span>Reference</span></li>\n </ol>\n </div>\n <div class=\"inc-nav-triad__origin\"></div>\n </div>\n </div>\n </header>\n <div class=\"inc-app-shell__body\">\n <div class=\"inc-app-shell__main\">\n <main class=\"inc-app-shell__content\">\n <div class=\"inc-section-container demo-stack\">\n <section class=\"inc-page-header\">\n <div class=\"inc-page-header__title\">\n <p class=\"demo-eyebrow\">Reference Catalog</p>\n <h1 class=\"inc-heading inc-heading--h1\">Rendered controls with copyable HTML</h1>\n <p class=\"inc-text inc-text--regular inc-text--muted\">This page is the practical copy/paste surface. Each section shows the rendered result first, then the HTML markup directly below it.</p>\n </div>\n </section>\n\n <div class=\"demo-muted-panel\">\n <div class=\"demo-section-header\">\n <div>\n <p class=\"demo-eyebrow\">Code View</p>\n <h2 class=\"inc-heading inc-heading--h3\">Web Components first, HTML + CSS on demand</h2>\n </div>\n <nav class=\"inc-tabs-line demo-mode-switcher\" aria-label=\"Reference code view\">\n <ul class=\"inc-tabs-nav\" role=\"tablist\">\n <li>\n <button class=\"inc-tab\" type=\"button\" role=\"tab\" aria-selected=\"false\" data-demo-code-mode=\"html\">HTML + CSS</button>\n </li>\n <li>\n <button class=\"inc-tab active\" type=\"button\" role=\"tab\" aria-selected=\"true\" data-demo-code-mode=\"wc\">Web Components</button>\n </li>\n </ul>\n </nav>\n </div>\n <p class=\"inc-text inc-text--regular inc-text--muted\">Web Components is the default code view on this page. Sections that are still CSS-first are labeled in the viewer so the page stays honest about what exists today.</p>\n </div>\n\n <section class=\"inc-card\">\n <div class=\"inc-card__header\">\n <h2 class=\"inc-card__title\">Theme Switcher</h2>\n </div>\n <div class=\"inc-card__body demo-reference-grid\">\n <div class=\"demo-preview demo-stack\">\n <div class=\"inc-theme-toggle\" data-inc-theme-switcher>\n <div class=\"inc-theme-toggle__label\">\n <p class=\"inc-theme-toggle__title\">Appearance</p>\n <p class=\"inc-theme-toggle__value\" data-inc-theme-label>System</p>\n </div>\n <div class=\"inc-button-group inc-button-group--sm\" role=\"group\" aria-label=\"Theme mode\">\n <button class=\"inc-btn inc-btn--secondary active\" type=\"button\" data-inc-theme-mode=\"light\">Light</button>\n <button class=\"inc-btn inc-btn--secondary\" type=\"button\" data-inc-theme-mode=\"dark\">Dark</button>\n <button class=\"inc-btn inc-btn--secondary\" type=\"button\" data-inc-theme-mode=\"system\">System</button>\n </div>\n <button class=\"inc-btn inc-btn--outline-secondary inc-btn--sm\" type=\"button\" data-inc-theme-toggle>Cycle</button>\n </div>\n <div data-inc-theme-switcher data-inc-theme-switcher-block></div>\n <p class=\"inc-text inc-text--regular inc-text--muted\">The bundled helper stores the selected mode in localStorage, resolves system against prefers-color-scheme, keeps the root `data-bs-theme` attribute in sync, and can either wire your own controls or mount the packaged switcher into an empty host.</p>\n </div>\n<pre class=\"demo-code\"><code>&lt;div class=\"inc-theme-toggle\" data-inc-theme-switcher&gt;\n &lt;div class=\"inc-theme-toggle__label\"&gt;\n &lt;p class=\"inc-theme-toggle__title\"&gt;Appearance&lt;/p&gt;\n &lt;p class=\"inc-theme-toggle__value\" data-inc-theme-label&gt;System&lt;/p&gt;\n &lt;/div&gt;\n &lt;div class=\"inc-button-group inc-button-group--sm\" role=\"group\" aria-label=\"Theme mode\"&gt;\n &lt;button class=\"inc-btn inc-btn--secondary\" type=\"button\" data-inc-theme-mode=\"light\"&gt;Light&lt;/button&gt;\n &lt;button class=\"inc-btn inc-btn--secondary\" type=\"button\" data-inc-theme-mode=\"dark\"&gt;Dark&lt;/button&gt;\n &lt;button class=\"inc-btn inc-btn--secondary\" type=\"button\" data-inc-theme-mode=\"system\"&gt;System&lt;/button&gt;\n &lt;/div&gt;\n &lt;button class=\"inc-btn inc-btn--outline-secondary inc-btn--sm\" type=\"button\" data-inc-theme-toggle&gt;Cycle&lt;/button&gt;\n&lt;/div&gt;\n\n&lt;div data-inc-theme-switcher data-inc-theme-switcher-block&gt;&lt;/div&gt;\n\n&lt;script&gt;\n window.IncTheme.setMode(\"dark\");\n&lt;/script&gt;</code></pre>\n </div>\n </section>\n\n <section class=\"inc-card\">\n <div class=\"inc-card__header\">\n <h2 class=\"inc-card__title\">Page Framing</h2>\n </div>\n <div class=\"inc-card__body demo-reference-grid\">\n <div class=\"demo-preview demo-stack\">\n <div class=\"inc-page inc-breadcrumb-body\">\n <div class=\"inc-page__breadcrumbs inc-breadcrumb-body__breadcrumb\">\n <ol class=\"inc-breadcrumb\">\n <li class=\"inc-breadcrumb__item\"><a href=\"./index.html\">Examples</a></li>\n <li class=\"inc-breadcrumb__item active\"><span>Reference</span></li>\n </ol>\n </div>\n <div class=\"inc-page__body inc-breadcrumb-body__body\">\n <div class=\"inc-section-container demo-stack\">\n <section class=\"inc-page-header\">\n <div class=\"inc-page-header__title\">\n <h3 class=\"inc-heading inc-heading--h3\">Breadcrumb body wrapper</h3>\n <p class=\"inc-text inc-text--regular inc-text--muted\">Use the canonical page wrapper when you want a breadcrumb strip and body stack without introducing another bespoke shell.</p>\n </div>\n <div class=\"inc-page-header__actions\">\n <button class=\"inc-btn inc-btn--secondary inc-btn--sm\" type=\"button\">Secondary action</button>\n <button class=\"inc-btn inc-btn--primary inc-btn--sm\" type=\"button\">Primary action</button>\n </div>\n </section>\n </div>\n </div>\n </div>\n </div>\n<pre class=\"demo-code\"><code>&lt;div class=\"inc-page inc-breadcrumb-body\"&gt;\n &lt;div class=\"inc-page__breadcrumbs inc-breadcrumb-body__breadcrumb\"&gt;\n &lt;ol class=\"inc-breadcrumb\"&gt;\n &lt;li class=\"inc-breadcrumb__item\"&gt;&lt;a href=\"./index.html\"&gt;Examples&lt;/a&gt;&lt;/li&gt;\n &lt;li class=\"inc-breadcrumb__item active\"&gt;&lt;span&gt;Reference&lt;/span&gt;&lt;/li&gt;\n &lt;/ol&gt;\n &lt;/div&gt;\n &lt;div class=\"inc-page__body inc-breadcrumb-body__body\"&gt;\n &lt;div class=\"inc-section-container demo-stack\"&gt;\n &lt;section class=\"inc-page-header\"&gt;...&lt;/section&gt;\n &lt;/div&gt;\n &lt;/div&gt;\n&lt;/div&gt;</code></pre>\n </div>\n </section>\n\n <section class=\"inc-card\">\n <div class=\"inc-card__header\">\n <h2 class=\"inc-card__title\">Buttons</h2>\n </div>\n <div class=\"inc-card__body demo-reference-grid\">\n <div class=\"demo-preview demo-stack\">\n <div class=\"demo-chip-row\">\n <button class=\"inc-btn inc-btn--primary\" type=\"button\">Primary</button>\n <button class=\"inc-btn inc-btn--secondary\" type=\"button\">Secondary</button>\n <button class=\"inc-btn inc-btn--outline-secondary\" type=\"button\">Outline</button>\n <button class=\"inc-btn inc-btn--danger\" type=\"button\">Danger</button>\n <button class=\"inc-btn inc-btn--warning\" type=\"button\">Warning</button>\n <button class=\"inc-btn inc-btn--info\" type=\"button\">Info</button>\n </div>\n <div class=\"demo-chip-row\">\n <button class=\"inc-btn inc-btn--primary inc-btn--sm\" type=\"button\">Small</button>\n <button class=\"inc-btn inc-btn--secondary inc-btn--micro\" type=\"button\">Micro</button>\n <div class=\"inc-button-group inc-button-group--sm\">\n <button class=\"inc-btn inc-btn--secondary\" type=\"button\">Left</button>\n <button class=\"inc-btn inc-btn--primary\" type=\"button\">Right</button>\n </div>\n </div>\n <div class=\"demo-chip-row\">\n <button class=\"inc-btn inc-btn--primary is-loading\" type=\"button\">Publishing<span class=\"inc-spinner inc-spinner--border inc-spinner--border--sm\" aria-hidden=\"true\"></span></button>\n <button class=\"inc-btn inc-btn--secondary is-loading\" type=\"button\">Refreshing<span class=\"inc-spinner inc-spinner--border inc-spinner--border--sm\" aria-hidden=\"true\"></span></button>\n </div>\n <div class=\"demo-chip-row\">\n <button class=\"inc-btn inc-btn--primary\" type=\"button\" aria-busy=\"true\"><span class=\"inc-spinner inc-spinner--border inc-spinner--border--sm\" aria-hidden=\"true\"></span><span>Publishing</span></button>\n <button class=\"inc-btn inc-btn--outline-secondary\" type=\"button\" aria-busy=\"true\"><span class=\"inc-spinner inc-spinner--border inc-spinner--border--sm\" aria-hidden=\"true\"></span><span>Refreshing</span></button>\n </div>\n </div>\n<pre class=\"demo-code\"><code>&lt;button class=\"inc-btn inc-btn--primary\" type=\"button\"&gt;Primary&lt;/button&gt;\n&lt;button class=\"inc-btn inc-btn--secondary\" type=\"button\"&gt;Secondary&lt;/button&gt;\n&lt;button class=\"inc-btn inc-btn--outline-secondary\" type=\"button\"&gt;Outline&lt;/button&gt;\n&lt;button class=\"inc-btn inc-btn--danger\" type=\"button\"&gt;Danger&lt;/button&gt;\n\n&lt;button class=\"inc-btn inc-btn--primary inc-btn--sm\" type=\"button\"&gt;Small&lt;/button&gt;\n&lt;button class=\"inc-btn inc-btn--secondary inc-btn--micro\" type=\"button\"&gt;Micro&lt;/button&gt;\n\n&lt;div class=\"inc-button-group inc-button-group--sm\"&gt;\n &lt;button class=\"inc-btn inc-btn--secondary\" type=\"button\"&gt;Left&lt;/button&gt;\n &lt;button class=\"inc-btn inc-btn--primary\" type=\"button\"&gt;Right&lt;/button&gt;\n&lt;/div&gt;\n\n&lt;button class=\"inc-btn inc-btn--primary is-loading\" type=\"button\"&gt;Publishing&lt;span class=\"inc-spinner inc-spinner--border inc-spinner--border--sm\" aria-hidden=\"true\"&gt;&lt;/span&gt;&lt;/button&gt;\n&lt;button class=\"inc-btn inc-btn--secondary is-loading\" type=\"button\"&gt;Refreshing&lt;span class=\"inc-spinner inc-spinner--border inc-spinner--border--sm\" aria-hidden=\"true\"&gt;&lt;/span&gt;&lt;/button&gt;\n\n&lt;button class=\"inc-btn inc-btn--primary\" type=\"button\" aria-busy=\"true\"&gt;&lt;span class=\"inc-spinner inc-spinner--border inc-spinner--border--sm\" aria-hidden=\"true\"&gt;&lt;/span&gt;&lt;span&gt;Publishing&lt;/span&gt;&lt;/button&gt;\n&lt;button class=\"inc-btn inc-btn--outline-secondary\" type=\"button\" aria-busy=\"true\"&gt;&lt;span class=\"inc-spinner inc-spinner--border inc-spinner--border--sm\" aria-hidden=\"true\"&gt;&lt;/span&gt;&lt;span&gt;Refreshing&lt;/span&gt;&lt;/button&gt;</code></pre>\n </div>\n </section>\n\n <section class=\"inc-card\">\n <div class=\"inc-card__header\">\n <h2 class=\"inc-card__title\">Badges And Alerts</h2>\n </div>\n <div class=\"inc-card__body demo-reference-grid\">\n <div class=\"demo-preview demo-stack\">\n <div class=\"demo-chip-row\">\n <span class=\"inc-badge inc-badge--success inc-badge--pill\">Approved</span>\n <span class=\"inc-badge inc-badge--warning inc-badge--pill\">Pending</span>\n <span class=\"inc-badge inc-badge--danger inc-badge--pill\">Rejected</span>\n <span class=\"inc-badge inc-badge--info inc-badge--pill\">Imported</span>\n </div>\n <div class=\"inc-alert inc-alert--success\">Success alert text.</div>\n <div class=\"inc-alert inc-alert--info\">Information alert text.</div>\n <div class=\"inc-alert inc-alert--warning\">Warning alert text.</div>\n <div class=\"inc-alert inc-alert--danger\">Danger alert text.</div>\n </div>\n<pre class=\"demo-code\"><code>&lt;span class=\"inc-badge inc-badge--success inc-badge--pill\"&gt;Approved&lt;/span&gt;\n&lt;span class=\"inc-badge inc-badge--warning inc-badge--pill\"&gt;Pending&lt;/span&gt;\n&lt;span class=\"inc-badge inc-badge--danger inc-badge--pill\"&gt;Rejected&lt;/span&gt;\n&lt;span class=\"inc-badge inc-badge--info inc-badge--pill\"&gt;Imported&lt;/span&gt;\n\n&lt;div class=\"inc-alert inc-alert--success\"&gt;Success alert text.&lt;/div&gt;\n&lt;div class=\"inc-alert inc-alert--info\"&gt;Information alert text.&lt;/div&gt;\n&lt;div class=\"inc-alert inc-alert--warning\"&gt;Warning alert text.&lt;/div&gt;\n&lt;div class=\"inc-alert inc-alert--danger\"&gt;Danger alert text.&lt;/div&gt;</code></pre>\n </div>\n </section>\n\n <section class=\"inc-card\">\n <div class=\"inc-card__header\">\n <h2 class=\"inc-card__title\">Form Fields</h2>\n </div>\n <div class=\"inc-card__body demo-reference-grid\">\n <div class=\"demo-preview demo-stack\">\n <div>\n <label class=\"inc-form__label\" for=\"ref-name\">Text input</label>\n <input id=\"ref-name\" class=\"inc-form__control\" type=\"text\" value=\"North Campus Expansion\">\n </div>\n <div>\n <label class=\"inc-form__label\" for=\"ref-status\">Select</label>\n <select id=\"ref-status\" class=\"inc-form__select\">\n <option>Draft</option>\n <option selected>In Progress</option>\n <option>Approved</option>\n </select>\n </div>\n <div>\n <label class=\"inc-form__label\" for=\"ref-notes\">Textarea</label>\n <textarea id=\"ref-notes\" class=\"inc-form__control\" rows=\"3\">Operator notes go here.</textarea>\n 