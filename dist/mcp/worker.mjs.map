      "body": "@use \"./inc-tokens\" as *;\n@import \"bootstrap/scss/bootstrap\";\n\n:root {\n --inc-surface-primary: var(--bs-body-bg);\n --inc-surface-secondary: var(--bs-secondary-bg);\n --inc-surface-muted: var(--bs-tertiary-bg);\n --inc-surface-highlight: var(--bs-primary-bg-subtle);\n --inc-surface-strong: #2a3142;\n --inc-surface-strong-rgb: 42, 49, 66;\n --inc-border-subtle: var(--bs-border-color-translucent);\n --inc-border-default: var(--bs-border-color);\n --inc-border-strong: var(--bs-secondary-color);\n --inc-text-primary: var(--bs-body-color);\n --inc-text-secondary: var(--bs-secondary-color);\n --inc-text-muted: var(--bs-tertiary-color);\n --inc-text-inverse: #ffffff;\n --inc-text-inverse-rgb: 255, 255, 255;\n --inc-text-link: var(--bs-link-color);\n --inc-text-link-hover: var(--bs-link-hover-color);\n --inc-control-surface: var(--inc-surface-primary);\n --inc-control-surface-text: var(--inc-text-primary);\n --inc-control-surface-border: var(--inc-border-default);\n --inc-surface-contrast: var(--bs-secondary);\n --inc-surface-contrast-rgb: var(--bs-secondary-rgb);\n --inc-surface-contrast-hover: #273042;\n --inc-surface-contrast-hover-rgb: 39, 48, 66;\n --inc-surface-contrast-active: #1f2737;\n --inc-surface-contrast-active-rgb: 31, 39, 55;\n --inc-surface-contrast-text: var(--inc-text-inverse);\n --inc-surface-contrast-text-rgb: var(--inc-text-inverse-rgb);\n --inc-surface-contrast-border: var(--bs-secondary);\n --inc-surface-primary-rgb: var(--bs-body-bg-rgb);\n --inc-surface-secondary-rgb: var(--bs-secondary-bg-rgb);\n --inc-surface-muted-rgb: var(--bs-tertiary-bg-rgb);\n --inc-surface-panel: rgba(var(--inc-surface-secondary-rgb), 0.56);\n --inc-surface-panel-cap: rgba(var(--inc-surface-secondary-rgb), 0.86);\n --inc-text-primary-rgb: var(--bs-body-color-rgb);\n --inc-text-secondary-rgb: var(--bs-secondary-color-rgb);\n --inc-text-muted-rgb: var(--bs-tertiary-color-rgb);\n --inc-shadow-rgb: var(--bs-black-rgb);\n --inc-surface-panel-shadow: 0 0.0625rem 0.125rem rgba(var(--inc-shadow-rgb), 0.05), 0 0.5rem 1.5rem rgba(var(--inc-shadow-rgb), 0.04), inset 0 1px 0 rgba(255, 255, 255, 0.58);\n --inc-surface-panel-shadow-raised: 0 0.125rem 0.25rem rgba(var(--inc-shadow-rgb), 0.06), 0 0.875rem 2rem rgba(var(--inc-shadow-rgb), 0.06), inset 0 1px 0 rgba(255, 255, 255, 0.62);\n}\n\n[data-bs-theme=\"dark\"] {\n --inc-control-surface: var(--inc-surface-secondary);\n --inc-control-surface-text: var(--inc-text-primary);\n --inc-control-surface-border: var(--inc-border-default);\n --inc-surface-contrast: var(--bs-gray-100);\n --inc-surface-contrast-rgb: 253, 253, 253;\n --inc-surface-contrast-hover: #dfe3e8;\n --inc-surface-contrast-hover-rgb: 223, 227, 232;\n --inc-surface-contrast-active: #c8d0d9;\n --inc-surface-contrast-active-rgb: 200, 208, 217;\n --inc-surface-contrast-text: var(--bs-dark);\n --inc-surface-contrast-text-rgb: 18, 19, 22;\n --inc-surface-contrast-border: var(--bs-gray-400);\n --inc-surface-panel: rgba(var(--inc-surface-secondary-rgb), 0.72);\n --inc-surface-panel-cap: rgba(var(--inc-surface-secondary-rgb), 0.9);\n --inc-surface-panel-shadow: 0 0.0625rem 0.125rem rgba(var(--inc-shadow-rgb), 0.22), 0 0.75rem 1.75rem rgba(var(--inc-shadow-rgb), 0.14), inset 0 1px 0 rgba(255, 255, 255, 0.06);\n --inc-surface-panel-shadow-raised: 0 0.125rem 0.25rem rgba(var(--inc-shadow-rgb), 0.28), 0 1rem 2.25rem rgba(var(--inc-shadow-rgb), 0.18), inset 0 1px 0 rgba(255, 255, 255, 0.08);\n --bs-success-bg-subtle: rgba(0, 151, 67, 0.18);\n --bs-success-border-subtle: rgb(72, 171, 109);\n --bs-form-valid-color: rgb(122, 214, 154);\n --bs-form-valid-border-color: rgb(122, 214, 154);\n --bs-danger-bg-subtle: rgba(209, 26, 42, 0.18);\n --bs-danger-border-subtle: rgb(219, 89, 105);\n --bs-form-invalid-color: rgb(248, 126, 143);\n --bs-form-invalid-border-color: rgb(248, 126, 143);\n --bs-warning-bg-subtle: rgba(200, 138, 0, 0.18);\n --bs-warning-border-subtle: rgb(214, 160, 41);\n}\n\n// -----------------------------------------------------------------------------\n// Typography\n// -----------------------------------------------------------------------------\n\n.inc-text {\n font-family: $font-family-sans-serif;\n color: var(--inc-text-primary);\n margin: 0;\n\n &--large {\n font-size: 1.125rem;\n line-height: 1.5;\n\n &-semibold {\n font-weight: 600;\n }\n\n &-regular {\n font-weight: 400;\n }\n }\n\n &--medium {\n font-size: 1rem;\n line-height: 1.5;\n\n &-semibold {\n font-weight: 600;\n }\n\n &-regular {\n font-weight: 400;\n }\n }\n\n &--regular {\n font-size: 0.875rem;\n line-height: 1.5;\n\n &-semibold {\n font-weight: 600;\n }\n\n &-regular {\n font-weight: 400;\n }\n }\n\n &--small {\n font-size: 0.75rem;\n line-height: 1.4;\n\n &-semibold {\n font-weight: 600;\n }\n\n &-regular {\n font-weight: 400;\n }\n }\n\n &--xs {\n font-size: 0.625rem;\n line-height: 1.3;\n\n &-semibold {\n font-weight: 600;\n }\n\n &-regular {\n font-weight: 400;\n }\n }\n\n &--muted {\n color: var(--inc-text-muted) !important;\n }\n\n &--lead {\n @extend .lead;\n }\n\n &--body {\n font-size: $font-size-base;\n line-height: $line-height-base;\n color: var(--inc-text-primary);\n }\n}\n\n.inc-heading {\n font-family: $headings-font-family;\n font-weight: $headings-font-weight;\n line-height: $headings-line-height;\n color: $headings-color;\n margin-bottom: 0.5rem;\n\n &--display {\n font-size: 2.25rem;\n font-weight: 600;\n letter-spacing: -0.04375rem;\n line-height: 1.1;\n\n @media (max-width: 767.98px) {\n font-size: 1.75rem;\n letter-spacing: -0.03125rem;\n }\n }\n\n &--h1 {\n @extend .h1;\n font-size: 1.5rem;\n font-weight: 600;\n letter-spacing: -0.0625rem;\n\n @media (max-width: 767.98px) {\n font-size: 1.25rem;\n letter-spacing: -0.03125rem;\n }\n }\n\n &--h2 {\n @extend .h2;\n font-size: 1.125rem;\n font-weight: 600;\n letter-spacing: -0.0625rem;\n }\n\n &--h3 {\n @extend .h3;\n font-size: 1rem;\n font-weight: 600;\n }\n\n &--h4 {\n @extend .h4;\n font-size: 0.875rem;\n font-weight: 600;\n }\n\n &--h5 {\n @extend .h5;\n font-size: 0.75rem;\n font-weight: 600;\n }\n\n &--h6 {\n @extend .h6;\n font-size: 0.75rem;\n font-weight: 600;\n }\n\n &--large {\n font-size: 2rem;\n font-weight: 600;\n letter-spacing: -0.0625rem;\n line-height: 1.1;\n\n @media (max-width: 767.98px) {\n font-size: 1.5rem;\n letter-spacing: -0.03125rem;\n }\n }\n\n &--overline {\n font-size: 0.75rem;\n font-weight: 500;\n letter-spacing: 0.1875rem;\n text-transform: uppercase;\n line-height: 1.2;\n }\n}\n\n.inc-data {\n font-family: $font-family-monospace;\n color: var(--inc-text-primary);\n margin: 0;\n\n &--display {\n font-size: 2rem;\n font-weight: 600;\n line-height: 1.1;\n }\n\n &--regular {\n font-size: 0.875rem;\n line-height: 1.4;\n\n &-semibold {\n font-weight: 600;\n }\n\n &-regular {\n font-weight: 400;\n }\n }\n\n &--small {\n font-size: 0.8125rem;\n line-height: 1.4;\n\n &-semibold {\n font-weight: 600;\n }\n\n &-regular {\n font-weight: 400;\n }\n }\n}\n\n.inc-button-text {\n font-family: $font-family-sans-serif;\n font-weight: 600;\n margin: 0;\n\n &--large {\n font-size: 1rem;\n }\n\n &--small {\n font-size: 0.75rem;\n }\n}\n\n.inc-heading-1 {\n @extend .inc-heading--h1;\n}\n\n.inc-heading-2 {\n @extend .inc-heading--h2;\n}\n\n.inc-heading-3 {\n @extend .inc-heading--h3;\n}\n\n.inc-heading-4 {\n @extend .inc-heading--h4;\n}\n\n.inc-heading-5 {\n @extend .inc-heading--h5;\n}\n\n.inc-heading-6 {\n @extend .inc-heading--h6;\n}\n\n.inc-text-body {\n @extend .inc-text--body;\n}\n\n.inc-text-muted {\n @extend .inc-text--muted;\n}\n\n.inc-text-lead {\n @extend .inc-text--lead;\n}\n\n.inc-table-text {\n font-size: 0.875rem;\n line-height: 1.4;\n\n &--small {\n font-size: 0.75rem;\n }\n\n &--data {\n font-family: $font-family-monospace;\n font-size: 0.8125rem;\n }\n}\n\n.inc-form-text {\n font-size: 0.875rem;\n line-height: 1.5;\n\n &--small {\n font-size: 0.75rem;\n }\n\n &--help {\n font-size: 0.75rem;\n color: var(--inc-text-muted);\n }\n}\n\n// -----------------------------------------------------------------------------\n// Utility layer\n// -----------------------------------------------------------------------------\n\n.inc-u-stack-xs > * + * {\n margin-top: 0.25rem !important;\n}\n\n.inc-u-stack-sm > * + * {\n margin-top: 0.5rem !important;\n}\n\n.inc-u-stack-md > * + * {\n margin-top: 1rem !important;\n}\n\n.inc-u-stack-lg > * + * {\n margin-top: 1.5rem !important;\n}\n\n.inc-u-gap-xs {\n gap: 0.25rem !important;\n}\n\n.inc-u-gap-sm {\n gap: 0.5rem !important;\n}\n\n.inc-u-gap-md {\n gap: 1rem !important;\n}\n\n.inc-u-gap-lg {\n gap: 1.5rem !important;\n}\n\n.inc-u-p-0 {\n padding: 0 !important;\n}\n\n.inc-u-p-xs {\n padding: 0.25rem !important;\n}\n\n.inc-u-p-sm {\n padding: 0.5rem !important;\n}\n\n.inc-u-p-md {\n padding: 1rem !important;\n}\n\n.inc-u-p-lg {\n padding: 1.5rem !important;\n}\n\n.inc-u-px-md {\n padding-inline: 1rem !important;\n}\n\n.inc-u-py-md {\n padding-block: 1rem !important;\n}\n\n.inc-u-hidden {\n display: none !important;\n}\n\n.inc-u-hidden-mobile {\n @include media-breakpoint-down(md) {\n display: none !important;\n }\n}\n\n.inc-u-hidden-desktop {\n @include media-breakpoint-up(lg) {\n display: none !important;\n }\n}\n\n.inc-u-visually-hidden {\n @include visually-hidden();\n}\n\n// -----------------------------------------------------------------------------\n// Buttons, badges, alerts, and form primitives\n// -----------------------------------------------------------------------------\n\n.inc-btn {\n @extend .btn;\n display: inline-flex;\n align-items: center;\n justify-content: center;\n gap: 0.375rem;\n vertical-align: middle;\n transition: color 0.18s ease, background-color 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;\n\n &--primary {\n @extend .btn-primary;\n }\n\n &--secondary {\n @extend .btn-secondary;\n --bs-btn-color: var(--inc-surface-contrast-text);\n --bs-btn-bg: var(--inc-surface-contrast);\n --bs-btn-border-color: var(--inc-surface-contrast-border);\n --bs-btn-hover-color: var(--inc-surface-contrast-text);\n --bs-btn-hover-bg: var(--inc-surface-contrast-hover);\n --bs-btn-hover-border-color: var(--inc-surface-contrast-hover);\n --bs-btn-focus-shadow-rgb: var(--inc-surface-contrast-rgb);\n --bs-btn-active-color: var(--inc-surface-contrast-text);\n --bs-btn-active-bg: var(--inc-surface-contrast-active);\n --bs-btn-active-border-color: var(--inc-surface-contrast-border);\n --bs-btn-disabled-color: var(--inc-surface-contrast-text);\n --bs-btn-disabled-bg: var(--inc-surface-contrast);\n --bs-btn-disabled-border-color: var(--inc-surface-contrast-border);\n box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.16), 0 1px 2px rgba(var(--inc-shadow-rgb), 0.1);\n\n &:hover,\n &:focus-visible {\n --bs-btn-hover-bg: var(--inc-surface-contrast-hover);\n --bs-btn-hover-border-color: var(--inc-surface-contrast-hover);\n box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12), 0 1px 2px rgba(var(--inc-shadow-rgb), 0.1);\n }\n\n &:active,\n &.active,\n &:focus:active {\n box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.14), inset 0 1px 0 rgba(255, 255, 255, 0.12);\n }\n }\n\n &--success {\n @extend .btn-success;\n color: $inc-text-inverse;\n }\n\n &--danger {\n @extend .btn-danger;\n }\n\n &--warning {\n @extend .btn-warning;\n color: #342200;\n background-color: $inc-warning-100;\n border-color: $inc-warning-700;\n\n &:hover,\n &:focus,\n &:active,\n &.active {\n color: #2d1d00;\n background-color: #f1b52d;\n border-color: $inc-warning-800;\n }\n }\n\n &--info {\n @extend .btn-info;\n color: $inc-text-inverse;\n }\n\n &--link {\n @extend .btn-link;\n }\n\n &--outline-primary {\n @extend .btn-outline-primary;\n }\n\n &--outline-secondary {\n @extend .btn-outline-secondary;\n --bs-btn-color: var(--inc-text-primary);\n --bs-btn-border-color: var(--inc-border-subtle);\n --bs-btn-hover-color: var(--inc-text-primary);\n --bs-btn-hover-bg: rgba(var(--inc-surface-strong-rgb), 0.12);\n --bs-btn-hover-border-color: rgba(var(--inc-surface-strong-rgb), 0.32);\n --bs-btn-focus-shadow-rgb: var(--inc-surface-strong-rgb);\n --bs-btn-active-color: var(--inc-text-primary);\n --bs-btn-active-bg: rgba(var(--inc-surface-strong-rgb), 0.18);\n --bs-btn-active-border-color: rgba(var(--inc-surface-strong-rgb), 0.4);\n --bs-btn-disabled-color: var(--inc-text-muted);\n --bs-btn-disabled-border-color: var(--inc-border-subtle);\n }\n\n &--outline-success {\n @extend .btn-outline-success;\n }\n\n &--outline-danger {\n @extend .btn-outline-danger;\n }\n\n &--outline-warning {\n @extend .btn-outline-warning;\n }\n\n &--outline-info {\n @extend .btn-outline-info;\n }\n\n &--outline-primary,\n &--outline-secondary,\n &--outline-success,\n &--outline-danger,\n &--outline-warning,\n &--outline-info {\n --bs-btn-bg: rgba(var(--inc-surface-secondary-rgb), 0.74);\n --bs-btn-disabled-bg: rgba(var(--inc-surface-secondary-rgb), 0.54);\n box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.4), 0 1px 2px rgba(var(--inc-shadow-rgb), 0.06);\n\n &:hover,\n &:focus-visible {\n box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3), 0 1px 2px rgba(var(--inc-shadow-rgb), 0.06);\n }\n\n &:active,\n &.active,\n &:focus:active {\n box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.18);\n }\n }\n\n &--sm {\n @extend .btn-sm;\n }\n\n &--lg {\n @extend .btn-lg;\n }\n\n &--micro {\n padding: $inc-control-density-micro-padding-block $inc-control-density-micro-padding-inline;\n font-size: $inc-control-density-micro-font-size;\n line-height: $inc-control-density-micro-line-height;\n border-radius: $inc-control-density-micro-border-radius;\n }\n\n &--nowrap {\n white-space: nowrap;\n text-overflow: ellipsis;\n overflow: hidden;\n }\n}\n\n.inc-button-group {\n @extend .btn-group;\n\n &--sm {\n @extend .btn-group-sm;\n }\n\n &--lg {\n @extend .btn-group-lg;\n }\n\n &--micro {\n > .inc-btn--micro {\n position: relative;\n\n &:not(:last-child) {\n border-top-right-radius: 0;\n border-bottom-right-radius: 0;\n }\n\n &:not(:first-child) {\n border-top-left-radius: 0;\n border-bottom-left-radius: 0;\n margin-left: -1px;\n }\n }\n }\n}\n\n.inc-button-toolbar {\n @extend .btn-toolbar;\n}\n\n.inc-close-button {\n @extend .btn-close;\n\n &--white {\n @extend .btn-close-white;\n }\n}\n\n.inc-badge {\n @extend .badge;\n display: inline-flex;\n align-items: center;\n gap: 0.25rem;\n background: rgba(var(--inc-surface-secondary-rgb), 0.88);\n color: var(--inc-text-secondary);\n border: 1px solid var(--inc-border-subtle);\n border-radius: 0.5rem;\n box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.48), 0 1px 2px rgba(var(--inc-shadow-rgb), 0.06);\n font-weight: 600;\n\n &--primary {\n @extend .bg-primary;\n }\n\n &--secondary {\n @extend .bg-secondary;\n }\n\n &--success {\n background-color: $inc-success-50;\n color: $inc-success-700;\n border: 1px solid $inc-success-700;\n }\n\n &--danger {\n background-color: $inc-danger-50;\n color: $inc-danger-700;\n border: 1px solid $inc-danger-700;\n }\n\n &--warning {\n background-color: #fff8df;\n color: #765000;\n border: 1px solid #b67b00;\n box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.58), 0 1px 2px rgba(182, 123, 0, 0.12);\n }\n\n &--info {\n background-color: $inc-blue-50;\n color: $inc-blue-700;\n border: 1px solid $inc-blue-700;\n }\n\n &--pill {\n @extend .rounded-pill;\n }\n}\n\n.inc-alert {\n @extend .alert;\n position: relative;\n overflow: hidden;\n border-radius: $inc-radius-md;\n box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.42), 0 0.375rem 1rem rgba(var(--inc-shadow-rgb), 0.05);\n background-clip: padding-box;\n\n &:empty {\n display: none;\n }\n\n &--primary {\n @extend .alert-primary;\n }\n\n &--secondary {\n @extend .alert-secondary;\n }\n\n &--success {\n @extend .alert-success;\n }\n\n &--danger {\n @extend .alert-danger;\n }\n\n &--warning {\n @extend .alert-warning;\n }\n\n &--info {\n @extend .alert-info;\n }\n\n &--dismissible {\n @extend .alert-dismissible;\n }\n\n &__heading {\n @extend .alert-heading;\n }\n\n &__progress {\n position: absolute;\n inset-inline: 0;\n in