      "searchText": "record-detail.html\nRaw curated file content for record-detail.html.\n<!DOCTYPE html>\n<html lang=\"en\" data-bs-theme=\"light\">\n<head>\n <meta charset=\"utf-8\">\n <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n <title>Incursa Design Language Showcase - Record Detail</title>\n <script>\n (() => {\n const storageKey = \"inc-theme-mode\";\n const resolveTheme = (mode) => mode === \"dark\" || mode === \"light\"\n ? mode\n : (window.matchMedia && window.matchMedia(\"(prefers-color-scheme: dark)\").matches ? \"dark\" : \"light\");\n let mode = \"system\";\n\n try {\n const storedMode = window.localStorage.getItem(storageKey);\n\n if (storedMode === \"light\" || storedMode === \"dark\" || storedMode === \"system\") {\n mode = storedMode;\n }\n } catch {\n // Ignore storage restrictions before the helper bootstraps.\n }\n\n document.documentElement.setAttribute(\"data-inc-theme-mode\", mode);\n document.documentElement.setAttribute(\"data-bs-theme\", resolveTheme(mode));\n document.documentElement.style.colorScheme = resolveTheme(mode);\n })();\n </script>\n <link rel=\"stylesheet\" href=\"./dist/inc-design-language.css\">\n <link rel=\"stylesheet\" href=\"./showcase.css\">\n</head>\n<body>\n <div class=\"inc-app-shell\">\n <header class=\"inc-app-shell__header\">\n <nav class=\"inc-navbar inc-navbar--app inc-navbar--expand-lg\">\n <div class=\"container-fluid\">\n <a class=\"inc-navbar__brand\" href=\"./index.html\">Incursa</a>\n <div class=\"inc-navbar__collapse\">\n <div class=\"inc-navbar__nav\">\n <a class=\"nav-link\" href=\"./index.html\">Examples</a>\n <a class=\"nav-link\" href=\"./demo.html\">Dashboard</a>\n <a class=\"nav-link\" href=\"./work-queue.html\">Work Queue</a>\n <a class=\"nav-link active\" href=\"./record-detail.html\">Record Detail</a>\n <a class=\"nav-link\" href=\"./native-patterns.html\">Native Patterns</a>\n <a class=\"nav-link\" href=\"./overlay-workflows.html\">Overlays</a>\n <a class=\"nav-link\" href=\"./states.html\">States</a>\n <a class=\"nav-link\" href=\"./forms-and-validation.html\">Forms</a>\n <a class=\"nav-link\" href=\"./data-grid-advanced.html\">Data Grid</a>\n <a class=\"nav-link\" href=\"./web-components.html\">Web Components</a>\n <a class=\"nav-link\" href=\"./reference.html\">Reference</a>\n </div>\n <div class=\"inc-navbar__utilities\">\n <div data-inc-theme-switcher data-inc-theme-switcher-variant=\"navbar\"></div>\n <details class=\"inc-native-menu inc-native-menu--navbar\">\n <summary class=\"inc-native-menu__summary\">\n <span class=\"inc-user-menu__avatar\">SM</span>\n <span class=\"inc-user-menu__meta\">\n <span class=\"inc-user-menu__name\">Sam McAravey</span>\n <span class=\"inc-user-menu__detail\">Administrator</span>\n </span>\n </summary>\n <div class=\"inc-native-menu__panel\">\n <div class=\"inc-native-menu__header\">Signed in as Sam McAravey</div>\n <a class=\"inc-native-menu__item\" href=\"#\">Profile</a>\n <a class=\"inc-native-menu__item\" href=\"#\">Preferences</a>\n <a class=\"inc-native-menu__item\" href=\"#\">Sign out</a>\n </div>\n </details>\n </div>\n </div>\n </div>\n </nav>\n <div class=\"inc-nav-triad\">\n <div class=\"inc-nav-triad__container\">\n <div class=\"inc-nav-triad__back\"></div>\n <div class=\"inc-nav-triad__breadcrumb\">\n <ol class=\"inc-breadcrumb\">\n <li class=\"inc-breadcrumb__item\"><a href=\"./index.html\">Examples</a></li>\n <li class=\"inc-breadcrumb__item active\"><span>Record Detail</span></li>\n </ol>\n </div>\n <div class=\"inc-nav-triad__origin\"></div>\n </div>\n </div>\n </header>\n <div class=\"inc-app-shell__body\">\n <div class=\"inc-app-shell__main\">\n <main class=\"inc-app-shell__content\">\n <div class=\"inc-section-container demo-stack\">\n <section class=\"inc-page-header\">\n <div class=\"inc-page-header__title\">\n <p class=\"demo-eyebrow\">Detail Pattern</p>\n <h1 class=\"inc-heading inc-heading--h1\">Project pay app record</h1>\n <p class=\"inc-text inc-text--regular inc-text--muted\">Three-column detail screens, right-rail actions, secondary menus, accordion sections, and a nested two-column content area.</p>\n </div>\n </section>\n\n <section class=\"inc-three-column-layout\">\n <aside class=\"inc-three-column-layout__left\">\n <div class=\"demo-sidebar-stack\">\n <article class=\"inc-card\">\n <div class=\"inc-card__header inc-card__header--compact\">\n <h2 class=\"inc-card__title\">Sections</h2>\n </div>\n <div class=\"inc-card__body\">\n <nav class=\"inc-sidebar-menu\" aria-label=\"Record sections\">\n <div class=\"inc-sidebar-menu__section\">\n <span class=\"inc-sidebar-menu__label\">Project Record</span>\n <a class=\"inc-sidebar-menu__item active\" href=\"#\">\n <span class=\"inc-sidebar-menu__text\">Overview</span>\n </a>\n <a class=\"inc-sidebar-menu__item\" href=\"#\">\n <span class=\"inc-sidebar-menu__text\">Billing details</span>\n </a>\n <a class=\"inc-sidebar-menu__item\" href=\"#\">\n <span class=\"inc-sidebar-menu__text\">Waivers</span>\n </a>\n <a class=\"inc-sidebar-menu__item\" href=\"#\">\n <span class=\"inc-sidebar-menu__text\">Notes</span>\n </a>\n </div>\n </nav>\n </div>\n </article>\n\n <article class=\"inc-card\">\n <div class=\"inc-card__header inc-card__header--compact\">\n <h2 class=\"inc-card__title\">Related Items</h2>\n </div>\n <div class=\"inc-card__body\">\n <div class=\"inc-list-group\">\n <a class=\"inc-list-group__item inc-list-group__item--action\" href=\"#\">North Campus contract</a>\n <a class=\"inc-list-group__item inc-list-group__item--action\" href=\"#\">Vendor profile</a>\n <a class=\"inc-list-group__item inc-list-group__item--action\" href=\"#\">Prior month pay app</a>\n </div>\n </div>\n </article>\n </div>\n </aside>\n\n <div class=\"inc-three-column-layout__main\">\n <div class=\"demo-stack\">\n <section class=\"inc-header-body inc-header-body--card\">\n <div class=\"inc-header-body__header\">\n <div>\n <h2 class=\"inc-header-body__title\">AP-2026-00142</h2>\n <p class=\"inc-header-body__subtitle\">North Campus Expansion / OpenPay Electric / March 2026</p>\n </div>\n <div class=\"demo-chip-row\">\n <span class=\"inc-badge inc-badge--warning inc-badge--pill\">Needs Review</span>\n <span class=\"inc-badge inc-badge--info inc-badge--pill\">Imported</span>\n </div>\n </div>\n <div class=\"inc-header-body__body\">\n <div class=\"inc-alert inc-alert--primary\">\n This detail pattern is intended for entity or case review screens where the center column does the heavy lifting and the right rail stays action-oriented.\n </div>\n </div>\n </section>\n\n <section class=\"inc-two-column-layout\">\n <article class=\"inc-two-column-layout__sidebar inc-card\">\n <div class=\"inc-card__header inc-card__header--compact\">\n <h2 class=\"inc-card__title\">Amounts</h2>\n </div>\n <div class=\"inc-card__body inc-stack inc-stack--gap-sm\">\n <div>\n <div class=\"inc-text inc-text--small inc-text--muted\">Current request</div>\n <div class=\"inc-data inc-data--display\">$18,240.22</div>\n </div>\n <div>\n <div class=\"inc-text inc-text--small inc-text--muted\">Previous billed</div>\n <div class=\"inc-data inc-data--regular-semibold\">$112,994.03</div>\n </div>\n <div>\n <div class=\"inc-text inc-text--small inc-text--muted\">Remaining contract</div>\n <div class=\"inc-data inc-data--regular-semibold\">$48,202.55</div>\n </div>\n </div>\n </article>\n\n <article class=\"inc-two-column-layout__content inc-card\">\n <div class=\"inc-card__header inc-card__header--compact\">\n <h2 class=\"inc-card__title\">Review Notes</h2>\n </div>\n <div class=\"inc-card__body\">\n <p class=\"inc-text inc-text--regular\">Use the nested two-column layout when a detail page needs a compact numeric summary beside a broader narrative or notes area. This keeps dense metadata visible without collapsing everything into one long card.</p>\n <p class=\"inc-text inc-text--regular\">For downstream products, this same pattern can hold case details, audit reasoning, configuration context, or document annotations.</p>\n </div>\n </article>\n </section>\n\n <article class=\"inc-card\">\n <div class=\"inc-card__header\">\n <h2 class=\"inc-card__title\">Section Stack</h2>\n </div>\n <div class=\"inc-card__body\">\n <div class=\"inc-accordion\" id=\"record-sections\" data-inc-accordion>\n <div class=\"inc-accordion__item\">\n <h2 class=\"inc-accordion__header\">\n <button id=\"record-billing-trigger\" class=\"inc-accordion__button\" type=\"button\" data-inc-toggle=\"collapse\" data-inc-target=\"#record-billing-panel\" aria-controls=\"record-billing-panel\" aria-expanded=\"true\">Billing summary</button>\n </h2>\n <div id=\"record-billing-panel\" class=\"inc-accordion__collapse show\" role=\"region\" aria-labelledby=\"record-billing-trigger\">\n <div class=\"inc-accordion__body\">\n <div class=\"inc-list-group\">\n <div class=\"inc-list-group__item\">Billing period: March 2026</div>\n <div class=\"inc-list-group__item\">Percent complete: 64%</div>\n <div class=\"inc-list-group__item\">Retention held: 10%</div>\n </div>\n </div>\n </div>\n </div>\n <div class=\"inc-accordion__item\">\n <h2 class=\"inc-accordion__header\">\n <button id=\"record-documents-trigger\" class=\"inc-accordion__button collapsed\" type=\"button\" data-inc-toggle=\"collapse\" data-inc-target=\"#record-documents-panel\" aria-controls=\"record-documents-panel\" aria-expanded=\"false\">Required documents</button>\n </h2>\n <div id=\"record-documents-panel\" class=\"inc-accordion__collapse\" role=\"region\" aria-labelledby=\"record-documents-trigger\">\n <div class=\"inc-accordion__body\">\n <div class=\"inc-list-group\">\n <div class=\"inc-list-group__item\">Conditional waiver received</div>\n <div class=\"inc-list-group__item\">Insurance certificate current</div>\n <div class=\"inc-list-group__item\">W-9 verification pending</div>\n </div>\n </div>\n </div>\n </div>\n </div>\n </div>\n </article>\n </div>\n </div>\n\n <aside class=\"inc-three-column-layout__right\">\n <div class=\"demo-sidebar-stack\">\n <article class=\"inc-card\">\n <div class=\"inc-card__header inc-card__header--compact\">\n <h2 class=\"inc-card__title\">Actions</h2>\n </div>\n <div class=\"inc-card__body inc-stack inc-stack--gap-sm\">\n <a class=\"inc-btn inc-btn--primary\" href=\"#\">Approve Record</a>\n <a class=\"inc-btn inc-btn--secondary\" href=\"#\">Request Changes</a>\n <a class=\"inc-btn inc-btn--outline-secondary\" href=\"#\">Send To Legal</a>\n </div>\n </article>\n\n <article class=\"inc-card\">\n <div class=\"inc-card__header inc-card__header--compact\">\n <h2 class=\"inc-card__title\">Status</h2>\n </div>\n <div class=\"inc-card__body inc-stack inc-stack--gap-sm\">\n <span class=\"inc-badge inc-badge--warning inc-badge--pill\">Needs Review</span>\n <span class=\"inc-badge inc-badge--info inc-badge--pill\">Imported 8:13 AM</span>\n <span class=\"inc-badge inc-badge--success inc-badge--pill\">Vendor matched</span>\n </div>\n </article>\n\n <article class=\"inc-card\">\n <div class=\"inc-card__header inc-card__header--compact\">\n <h2 class=\"inc-card__title\">Activity Feed</h2>\n </div>\n <div class=\"inc-card__body\">\n <div class=\"inc-vertical-list inc-vertical-list--comfy inc-vertical-list--trim\">\n <div class=\"inc-vertical-list__item\">\n <div class=\"inc-text inc-text--regular-semibold\">Imported from OpenPay</div>\n <div class=\"inc-text inc-text--small inc-text--muted\">8:13 AM by nightly sync</div>\n </div>\n <div class=\"inc-vertical-list__item\">\n <div class=\"inc-text inc-text--regular-semibold\">Routing rule matched</div>\n <div class=\"inc-text inc-text--small inc-text--muted\">Assigned to AP Team for first-pass review</div>\n </div>\n <div class=\"inc-vertical-list__item\">\n <div class=\"inc-text inc-text--regular-semibold\">Waiver check flagged</div>\n <div class=\"inc-text inc-text--small inc-text--muted\">W-9 verification still missing from vendor profile</div>\n </div>\n </div>\n </div>\n </article>\n </div>\n </aside>\n </section>\n </div>\n </main>\n <footer class=\"inc-app-shell__footer inc-footer-bar\">\n <div class=\"inc-footer-bar__meta\">Detail example for three-column layout, side rails, and accordion sections.</div>\n </footer>\n </div>\n </div>\n </div>\n <script src=\"./dist/inc-design-language.js\"></script>\n</body>\n</html>\n\nrecord-detail.html\nrecord-detail-html\nrecord-detail.html"
    },
