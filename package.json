{
  "name": "@incursa/ui-kit",
  "version": "1.9.0",
  "private": false,
  "description": "CSS-first UI kit for data-heavy business applications, with optional JS helpers and Web Components.",
  "keywords": [
    "ui-kit",
    "design-system",
    "css",
    "scss",
    "web-components",
    "bootstrap",
    "b2b",
    "admin-ui",
    "razor-pages"
  ],
  "homepage": "https://github.com/incursa/ui-kit#readme",
  "bugs": {
    "url": "https://github.com/incursa/ui-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/incursa/ui-kit.git"
  },
  "license": "Apache-2.0",
  "author": "Samuel McAravey",
  "type": "commonjs",
  "exports": {
    ".": {
      "style": "./dist/inc-design-language.css",
      "sass": "./src/inc-design-language.scss",
      "default": "./dist/inc-design-language.js"
    },
    "./web-components": {
      "style": "./dist/web-components/style.css",
      "default": "./dist/web-components/index.js"
    },
    "./icons": {
      "default": "./dist/icons/index.js"
    },
    "./web-components/style.css": "./dist/web-components/style.css",
    "./dist/inc-design-language.css": "./dist/inc-design-language.css",
    "./dist/inc-design-language.min.css": "./dist/inc-design-language.min.css",
    "./src/inc-design-language.scss": "./src/inc-design-language.scss",
    "./src/_inc-theme.scss": "./src/_inc-theme.scss",
    "./src/_inc-tokens.scss": "./src/_inc-tokens.scss"
  },
  "main": "./dist/inc-design-language.js",
  "files": [
    "dist",
    "src",
    "README.md",
    "LLMS.txt",
    "AI-AGENT-INSTRUCTIONS.md",
    "NOTICE"
  ],
  "scripts": {
    "build:css": "sass --load-path=node_modules --quiet-deps --silence-deprecation=import src/inc-design-language.scss dist/inc-design-language.css --style=expanded",
    "build:css:min": "sass --load-path=node_modules --quiet-deps --silence-deprecation=import src/inc-design-language.scss dist/inc-design-language.min.css --style=compressed",
    "build:icons": "node scripts/build-icons.mjs",
    "build:js": "esbuild src/inc-design-language.js --bundle --format=iife --platform=browser --outfile=dist/inc-design-language.js",
    "build:wc": "node scripts/build-web-components.mjs",
    "build:mcp:manifests": "node scripts/generate-mcp.mjs",
    "build:mcp": "node scripts/build-mcp.mjs",
    "build": "npm run build:icons && npm run build:css && npm run build:css:min && npm run build:js && npm run build:wc && npm run build:mcp",
    "docs:check": "node scripts/linkify-markdown-docs.mjs --check",
    "test:browser:install": "playwright install chromium",
    "test:browser": "playwright test",
    "test:mcp": "node --test tests/mcp/transport.test.mjs tests/mcp/search.test.mjs tests/mcp/installation.test.mjs tests/mcp/markup.test.mjs tests/mcp/freshness.test.mjs",
    "smoke": "node scripts/verify-ui-kit.mjs",
    "verify": "npm run docs:check && npm run smoke && npm run build && npm run test:mcp && npm pack --dry-run",
    "deploy:mcp": "npm run build:mcp && wrangler deploy --config wrangler.toml",
    "preversion": "npm run verify",
    "release:patch": "node scripts/assert-changelog-version.mjs patch && npm version patch",
    "release:minor": "node scripts/assert-changelog-version.mjs minor && npm version minor",
    "release:major": "node scripts/assert-changelog-version.mjs major && npm version major",
    "pack:tarball": "npm pack",
    "package": "npm run build && npm run smoke && npm run pack:tarball"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "lucide": "^1.17.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@playwright/test": "^1.58.2",
    "bootstrap": "^5.3.3",
    "esbuild": "^0.27.4",
    "linkedom": "^0.18.12",
    "sass": "^1.98.0",
    "wrangler": "^4.79.0",
    "zod": "^4.3.6"
  },
  "overrides": {
    "picomatch": "4.0.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "style": "./dist/inc-design-language.css",
  "sass": "./src/inc-design-language.scss"
}
